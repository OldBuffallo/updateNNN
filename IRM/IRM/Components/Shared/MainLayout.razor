@namespace IRM.Components.Layout
@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using IRM.Services
@using IRM.Components.Theming
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject ILogger<MainLayout> Logger
@implements IDisposable


<AuthorizeView>
    <Authorized Context="auth">
        <MudLayout Class="irm-shell">
            <!-- ════════════ TOPBAR ════════════ -->
            <MudAppBar Elevation="0" Dense="true" Class="irm-topbar">
                <MudIconButton Icon="@Icons.Material.Outlined.Menu"
                               Color="Color.Inherit"
                               Edge="Edge.Start"
                               Class="mr-2 topbar-menu-btn"
                               OnClick="@(() => _drawerOpen = !_drawerOpen)" />

                <div class="topbar-brand d-none d-sm-flex align-center">
                    <div class="topbar-logo-icon">
                        <MudIcon Icon="@Icons.Material.Outlined.FactCheck" Size="Size.Small" Color="Color.Inherit" />
                    </div>
                    <MudText Typo="Typo.subtitle1" Class="topbar-title ml-2 font-weight-bold">IRM</MudText>
                    <span class="topbar-version-badge ml-2">v1.0.2</span>
                </div>

                <!-- Global Spotlight Search Trigger -->
                <div class="topbar-search-wrapper mx-4 d-none d-md-flex" @onclick="OpenSpotlight">
                    <MudIcon Icon="@Icons.Material.Outlined.Search" Size="Size.Small" Class="search-icon" />
                    <span class="search-placeholder">Tìm kiếm nhanh người nước ngoài, công ty, địa bàn...</span>
                    <span class="search-shortcut">Ctrl + K</span>
                </div>

                <MudSpacer />

                <div class="topbar-actions d-flex align-center gap-2">
                    <!-- Mobile Search Button -->
                    <MudIconButton Icon="@Icons.Material.Outlined.Search"
                                   Color="Color.Inherit"
                                   Class="d-flex d-md-none"
                                   OnClick="OpenSpotlight"
                                   id="btnGlobalSpotlight" />

                    <!-- Quick Add Action Menu -->
                    <AuthorizeView Roles="ADMIN,DATA_EDITOR" Context="permCtx">
                        <MudMenu Icon="@Icons.Material.Outlined.AddCircle"
                                 Color="Color.Primary"
                                 Variant="Variant.Filled"
                                 Size="Size.Small"
                                 Label="Thêm nhanh"
                                 EndIcon="@Icons.Material.Outlined.KeyboardArrowDown"
                                 Class="topbar-quick-add d-none d-sm-inline-flex"
                                 Dense="true"
                                 AnchorOrigin="Origin.BottomRight"
                                 TransformOrigin="Origin.TopRight">
                            <MudMenuItem Icon="@Icons.Material.Outlined.PersonAdd" OnClick='() => Navigation.NavigateTo("/employees")'>
                                Thêm nhân viên NNN
                            </MudMenuItem>
                            <MudMenuItem Icon="@Icons.Material.Outlined.FamilyRestroom" OnClick='() => Navigation.NavigateTo("/family-visitors")'>
                                Thêm người thăm thân
                            </MudMenuItem>
                            <MudMenuItem Icon="@Icons.Material.Outlined.Hotel" OnClick='() => Navigation.NavigateTo("/accommodations")'>
                                Thêm cơ sở lưu trú
                            </MudMenuItem>
                            <MudMenuItem Icon="@Icons.Material.Outlined.FactCheck" OnClick='() => Navigation.NavigateTo("/inspections")'>
                                Tạo đợt kiểm tra
                            </MudMenuItem>
                            <MudDivider />
                            <MudMenuItem Icon="@Icons.Material.Outlined.UploadFile" OnClick='() => Navigation.NavigateTo("/import")'>
                                Import Excel
                            </MudMenuItem>
                        </MudMenu>
                    </AuthorizeView>

                    <!-- Theme Toggle Button -->
                    <MudTooltip Text="@(_darkMode ? "Chuyển chế độ sáng" : "Chuyển chế độ tối")">
                        <MudIconButton Icon="@(_darkMode ? Icons.Material.Outlined.LightMode : Icons.Material.Outlined.DarkMode)"
                                       Color="Color.Inherit"
                                       Class="theme-toggle-btn"
                                       OnClick="ToggleTheme" />
                    </MudTooltip>

                    <!-- User Profile & Menu -->
                    @{
                        var displayName = auth.User.FindFirst("display_name")?.Value ?? auth.User.Identity?.Name ?? "Người dùng";
                        var isAdmin = auth.User.IsInRole(IrmRoles.Admin);
                        var roleLabel = isAdmin ? "Quản trị viên" : "Cán bộ quản lý";
                        var initial = !string.IsNullOrEmpty(displayName) ? displayName[0].ToString().ToUpper() : "U";
                    }

                    <MudMenu AnchorOrigin="Origin.BottomRight"
                             TransformOrigin="Origin.TopRight"
                             Class="user-profile-menu"
                             Dense="true">
                        <ActivatorContent Context="userMenu">
                            <MudButton Class="user-pill d-flex align-center cursor-pointer"
                                       Variant="Variant.Text" OnClick="userMenu.ToggleAsync"
                                       aria-label="Tài khoản người dùng">
                                <div class="user-avatar">@initial</div>
                                <div class="user-info d-none d-lg-flex flex-column text-left ml-2">
                                    <span class="user-name">@displayName</span>
                                    <span class="user-role">@roleLabel</span>
                                </div>
                                <MudIcon Icon="@Icons.Material.Outlined.KeyboardArrowDown" Size="Size.Small" Class="ml-1 text-muted" />
                            </MudButton>
                        </ActivatorContent>
                        <ChildContent>
                            <div class="pa-3 user-menu-header">
                                <MudText Typo="Typo.subtitle2" Style="font-weight: 700;">@displayName</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Quyền: @roleLabel</MudText>
                            </div>
                            <MudDivider />
                            <MudMenuItem Icon="@Icons.Material.Outlined.Dashboard" OnClick='() => Navigation.NavigateTo("/")'>
                                Bảng điều khiển
                            </MudMenuItem>
                            <MudMenuItem Icon="@Icons.Material.Outlined.Search" OnClick='() => Navigation.NavigateTo("/search")'>
                                Tìm kiếm dữ liệu
                            </MudMenuItem>
                            <AuthorizeView Roles="ADMIN" Context="adminCtx">
                                <MudMenuItem Icon="@Icons.Material.Outlined.AdminPanelSettings" OnClick='() => Navigation.NavigateTo("/admin")'>
                                    Quản trị hệ thống
                                </MudMenuItem>
                            </AuthorizeView>
                            <MudDivider />
                            <form method="post" action="/auth/logout" class="logout-form">
                                <button type="submit" class="logout-menu-item">
                                    <MudIcon Icon="@Icons.Material.Outlined.Logout" Size="Size.Small" Color="Color.Error" Class="mr-2" />
                                    <span class="text-danger">Đăng xuất</span>
                                </button>
                            </form>
                        </ChildContent>
                    </MudMenu>
                </div>
            </MudAppBar>

            <!-- ════════════ SIDEBAR ════════════ -->
            <MudDrawer @bind-Open="_drawerOpen"
                       Elevation="0"
                       ClipMode="DrawerClipMode.Always"
                       Variant="DrawerVariant.Responsive"
                       Breakpoint="Breakpoint.Lg"
                       Class="irm-drawer">
                <div class="irm-drawer-header d-flex align-center px-4 py-3">
                    <div class="drawer-logo-icon">
                        <MudIcon Icon="@Icons.Material.Outlined.Security" Color="Color.Inherit" />
                    </div>
                    <div class="ml-3 flex-grow-1">
                        <div class="drawer-title">QUẢN LÝ NNN</div>
                        <div class="drawer-sub">Hệ thống báo cáo & giám sát</div>
                    </div>
                </div>

                <div class="drawer-nav-container">
                    <NavMenu />
                </div>

                <div class="drawer-footer px-4 py-3">
                    <div class="d-flex align-center justify-space-between">
                        <div class="d-flex align-center">
                            <span class="status-indicator-dot online"></span>
                            <span class="drawer-footer-text ml-2">Hệ thống sẵn sàng</span>
                        </div>
                        <span class="drawer-version-tag">v1.0.2</span>
                    </div>
                </div>
            </MudDrawer>

            <!-- ════════════ MAIN CONTENT ════════════ -->
            <MudMainContent Class="irm-main">
                <MudContainer MaxWidth="MaxWidth.False" Class="irm-main-container">
                    <CascadingValue Value="@auth.User.IsInRole(IrmRoles.Admin)" Name="IsAdmin">
                        @Body
                    </CascadingValue>
                </MudContainer>
            </MudMainContent>

            <!-- Spotlight Search Modal Component -->
            <SpotlightSearch @bind-IsOpen="_spotlightOpen" />
        </MudLayout>
    </Authorized>
    <NotAuthorized>
        <div class="login-screen active-screen">
            <div class="login-bg">
                <div class="login-card">
                    <div class="login-logo">
                        <div class="logo-icon"><MudIcon Icon="@Icons.Material.Outlined.FactCheck" Color="Color.Inherit" /></div>
                        <h1>Immigration Report Manager</h1>
                        <p class="login-subtitle">Quản lý người nước ngoài · Phiên bản v1.0.2</p>
                    </div>
                    <form method="post" action="/auth/login">
                        <div class="input-group">
                            <label for="loginUser">Tài khoản</label>
                            <input type="text" id="loginUser" name="username" autocomplete="username" required placeholder="Nhập tên đăng nhập..." />
                        </div>
                        <div class="input-group">
                            <label for="loginPass">Mật khẩu</label>
                            <input type="password" id="loginPass" name="password" autocomplete="current-password" required placeholder="Nhập mật khẩu..." />
                        </div>
                        @if (Navigation.Uri.Contains("loginError=1", StringComparison.Ordinal))
                        {
                            <div class="login-error-alert">
                                <MudIcon Icon="@Icons.Material.Outlined.ErrorOutline" Size="Size.Small" Class="mr-1" />
                                <span>Sai thông tin đăng nhập hoặc tài khoản tạm khóa.</span>
                            </div>
                        }
                        <button type="submit" class="btn-login">
                            <span>Đăng nhập hệ thống</span>
                            <MudIcon Icon="@Icons.Material.Outlined.ArrowForward" Size="Size.Small" Class="ml-2" />
                        </button>
                    </form>
                    <div class="login-footer">
                        <span class="secure-badge">
                            <MudIcon Icon="@Icons.Material.Outlined.Lock" Size="Size.Small" Class="mr-1" />
                            Cookie bảo mật · RBAC phía máy chủ
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool _drawerOpen = true;
    [CascadingParameter] private IrmThemeContext Theme { get; set; } = null!;
    private bool _darkMode => Theme.IsDarkMode;
    private bool _spotlightOpen;
    private DotNetObjectReference<MainLayout>? _dotNetRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);

            try
            {
                await JS.InvokeVoidAsync("irmInterop.registerShortcutHandler", _dotNetRef);
            }
            catch (JSException ex)
            {
                // Global shortcuts are progressive enhancement. A stale client-side
                // asset must never terminate the Blazor circuit.
                Logger.LogWarning(ex, "Unable to register the global shortcut handler");
            }

            StateHasChanged();
        }
    }

    [JSInvokable]
    public void OpenSpotlight()
    {
        _spotlightOpen = true;
        StateHasChanged();
    }

    private Task ToggleTheme() => Theme.ToggleAsync();

    public void Dispose()
    {
        _dotNetRef?.Dispose();
    }
}
