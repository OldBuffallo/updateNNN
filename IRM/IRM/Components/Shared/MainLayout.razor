@namespace IRM.Components.Layout
@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using IRM.Services
@using IRM.Components.Shared
@using IRM.Components.Theming
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject ILogger<MainLayout> Logger
@implements IDisposable


<AuthorizeView>
    <Authorized Context="auth">
        @{
            var displayName = auth.User.FindFirst("display_name")?.Value ?? auth.User.Identity?.Name ?? "Người dùng";
            var isAdmin = auth.User.IsInRole(IrmRoles.Admin);
            var roleLabel = isAdmin ? "Quản trị viên" : "Cán bộ quản lý";
            var initial = !string.IsNullOrEmpty(displayName) ? displayName[0].ToString().ToUpper() : "U";
        }
        <MudLayout Class="irm-shell">
            <!-- ════════════ TOPBAR ════════════ -->
            <MudAppBar Elevation="0" Class="irm-topbar">
                <MudIconButton Icon="@Icons.Material.Outlined.Menu"
                               Color="Color.Inherit"
                               Edge="Edge.Start"
                               Class="mr-2 topbar-menu-btn"
                               OnClick="@(() => _drawerOpen = !_drawerOpen)" />

                <div class="topbar-brand d-none d-sm-flex align-center">
                    <div class="topbar-logo-icon">
                        <MudIcon Icon="@Icons.Material.Outlined.FactCheck" Size="Size.Small" Color="Color.Inherit" />
                    </div>
                    <MudText Typo="Typo.subtitle1" Class="topbar-title ml-2 font-weight-bold">IRM</MudText>
                    <span class="topbar-version-badge ml-2">v1.0.2</span>
                </div>

                <!-- Global Spotlight Search Trigger -->
                <div class="topbar-search-wrapper mx-4 d-none d-md-flex" @onclick="OpenSpotlight">
                    <MudIcon Icon="@Icons.Material.Outlined.Search" Size="Size.Small" Class="search-icon" />
                    <span class="search-placeholder">Tìm kiếm nhanh người nước ngoài, công ty, địa bàn...</span>
                    <span class="search-shortcut">Ctrl + K</span>
                </div>

                <MudSpacer />

                <div class="topbar-actions d-flex align-center gap-2">
                    <!-- Mobile Search Button -->
                    <MudIconButton Icon="@Icons.Material.Outlined.Search"
                                   Color="Color.Inherit"
                                   Class="d-flex d-md-none"
                                   OnClick="OpenSpotlight"
                                   id="btnGlobalSpotlight" />

                    <!-- Quick Add Action Menu -->
                    <AuthorizeView Roles="ADMIN,DATA_EDITOR" Context="permCtx">
                        <MudMenu Class="topbar-quick-add d-none d-sm-inline-flex"
                                 Dense="true"
                                 AnchorOrigin="Origin.BottomRight"
                                 TransformOrigin="Origin.TopRight">
                            <ActivatorContent Context="quickAddMenu">
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           StartIcon="@Icons.Material.Outlined.Add"
                                           EndIcon="@Icons.Material.Outlined.KeyboardArrowDown"
                                           OnClick="quickAddMenu.ToggleAsync">
                                    Thêm nhanh
                                </MudButton>
                            </ActivatorContent>
                            <ChildContent>
                                <MudMenuItem Icon="@Icons.Material.Outlined.PersonAdd" OnClick='() => Navigation.NavigateTo("/employees")'>
                                    Thêm nhân viên NNN
                                </MudMenuItem>
                                <MudMenuItem Icon="@Icons.Material.Outlined.FamilyRestroom" OnClick='() => Navigation.NavigateTo("/family-visitors")'>
                                    Thêm người thăm thân
                                </MudMenuItem>
                                <MudMenuItem Icon="@Icons.Material.Outlined.Hotel" OnClick='() => Navigation.NavigateTo("/accommodations")'>
                                    Thêm cơ sở lưu trú
                                </MudMenuItem>
                                <MudMenuItem Icon="@Icons.Material.Outlined.FactCheck" OnClick='() => Navigation.NavigateTo("/inspections")'>
                                    Tạo đợt kiểm tra
                                </MudMenuItem>
                                <MudDivider />
                                <MudMenuItem Icon="@Icons.Material.Outlined.UploadFile" OnClick='() => Navigation.NavigateTo("/import")'>
                                    Import Excel
                                </MudMenuItem>
                            </ChildContent>
                        </MudMenu>
                    </AuthorizeView>

                    <!-- Customer Feedback Survey Menu & Initial Spotlight Target -->
                    <MudMenu Class="topbar-feedback-menu"
                             Dense="true"
                             AnchorOrigin="Origin.BottomRight"
                             TransformOrigin="Origin.TopRight">
                        <ActivatorContent Context="feedbackMenu">
                            <MudButton id="btnCustomerFeedback"
                                       Variant="Variant.Outlined"
                                       Color="Color.Warning"
                                       Size="Size.Small"
                                       Class="irm-feedback-btn"
                                       StartIcon="@Icons.Material.Outlined.RateReview"
                                       EndIcon="@Icons.Material.Outlined.KeyboardArrowDown"
                                       OnClick="feedbackMenu.ToggleAsync">
                                <span>Khảo sát &amp; Góp ý</span>
                                <span class="irm-feedback-badge">R6</span>
                            </MudButton>
                        </ActivatorContent>
                        <ChildContent>
                            <MudMenuItem Icon="@Icons.Material.Outlined.OpenInNew"
                                         OnClick="OpenFeedbackSurveyHtmlAsync">
                                Mở phiếu khảo sát trực tuyến (HTML)
                            </MudMenuItem>
                            <MudMenuItem Icon="@Icons.Material.Outlined.Download"
                                         Href="/PHIEU-KHAO-SAT-GOP-Y.xlsx"
                                         Target="_blank">
                                Tải phiếu khảo sát Excel (.xlsx)
                            </MudMenuItem>
                            <MudDivider />
                            <MudMenuItem Icon="@Icons.Material.Outlined.HelpOutline"
                                         OnClick="ReplayFeedbackSpotlightAsync">
                                Xem lại hướng dẫn vị trí góp ý
                            </MudMenuItem>
                        </ChildContent>
                    </MudMenu>

                    <!-- Table Density Toggle Button -->
                    <MudTooltip Text="@(_compactDensity ? "Mật độ bảng: Gọn (Nhấn để chuyển sang Thoáng)" : "Mật độ bảng: Thoáng (Nhấn để chuyển sang Gọn)")">
                        <MudIconButton Icon="@(_compactDensity ? Icons.Material.Outlined.ViewHeadline : Icons.Material.Outlined.ViewAgenda)"
                                       Color="Color.Inherit"
                                       Class="density-toggle-btn"
                                       aria-label="Chuyển mật độ hiển thị bảng"
                                       OnClick="ToggleDensityAsync" />
                    </MudTooltip>

                    <!-- Theme Toggle Button -->
                    <MudTooltip Text="@(_darkMode ? "Chuyển chế độ sáng" : "Chuyển chế độ tối")">
                        <MudIconButton Icon="@(_darkMode ? Icons.Material.Outlined.LightMode : Icons.Material.Outlined.DarkMode)"
                                       Color="Color.Inherit"
                                       Class="theme-toggle-btn"
                                       OnClick="ToggleTheme" />
                    </MudTooltip>

                    <!-- User Profile & Menu -->
                    <MudMenu AnchorOrigin="Origin.BottomRight"
                             TransformOrigin="Origin.TopRight"
                             Class="user-profile-menu"
                             Dense="true">
                        <ActivatorContent Context="userMenu">
                            <MudButton Class="user-pill d-flex align-center cursor-pointer"
                                       Variant="Variant.Text" OnClick="userMenu.ToggleAsync"
                                       aria-label="Tài khoản người dùng">
                                <div class="user-avatar">@initial</div>
                                <div class="user-info d-none d-lg-flex flex-column text-left ml-2">
                                    <span class="user-name">@displayName</span>
                                    <span class="user-role">@roleLabel</span>
                                </div>
                                <MudIcon Icon="@Icons.Material.Outlined.KeyboardArrowDown" Size="Size.Small" Class="ml-1 text-muted" />
                            </MudButton>
                        </ActivatorContent>
                        <ChildContent>
                            <div class="pa-3 user-menu-header">
                                <MudText Typo="Typo.subtitle2" Style="font-weight: 700;">@displayName</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Quyền: @roleLabel</MudText>
                            </div>
                            <MudDivider />
                            <MudMenuItem Icon="@Icons.Material.Outlined.Dashboard" OnClick='() => Navigation.NavigateTo("/")'>
                                Bảng điều khiển
                            </MudMenuItem>
                            <MudMenuItem Icon="@Icons.Material.Outlined.Search" OnClick='() => Navigation.NavigateTo("/search")'>
                                Tìm kiếm dữ liệu
                            </MudMenuItem>
                            <AuthorizeView Roles="ADMIN" Context="adminCtx">
                                <MudMenuItem Icon="@Icons.Material.Outlined.AdminPanelSettings" OnClick='() => Navigation.NavigateTo("/admin")'>
                                    Quản trị hệ thống
                                </MudMenuItem>
                            </AuthorizeView>
                            <MudDivider />
                            <form method="post" action="/auth/logout" class="logout-form">
                                <button type="submit" class="logout-menu-item">
                                    <MudIcon Icon="@Icons.Material.Outlined.Logout" Size="Size.Small" Color="Color.Error" Class="mr-2" />
                                    <span class="text-danger">Đăng xuất</span>
                                </button>
                            </form>
                        </ChildContent>
                    </MudMenu>
                </div>
            </MudAppBar>

            <!-- ════════════ SIDEBAR ════════════ -->
            <MudDrawer @bind-Open="_drawerOpen"
                       Elevation="0"
                       ClipMode="DrawerClipMode.Always"
                       Variant="DrawerVariant.Responsive"
                       Breakpoint="Breakpoint.Md"
                       Class="irm-drawer">
                <div class="irm-drawer-header">
                    <div class="drawer-profile-card">
                        <div class="drawer-avatar-ring">
                            <img src="images/logo-cand.png" alt="CAND" class="drawer-avatar-img" />
                            <span class="drawer-avatar-status"></span>
                        </div>
                        <div class="drawer-profile-info">
                            <div class="drawer-title">@displayName</div>
                            <div class="drawer-sub">@roleLabel · IRM v1.0.2</div>
                        </div>
                    </div>
                </div>

                <div class="drawer-nav-container">
                    <NavMenu />
                </div>

                <div class="drawer-footer">
                    <div class="drawer-active-label">TRẠNG THÁI HỆ THỐNG</div>
                    <div class="drawer-active-row">
                        <div class="drawer-avatar-stack">
                            <span class="stack-bubble stack-1">QN</span>
                            <span class="stack-bubble stack-2">HL</span>
                            <span class="stack-bubble stack-3">MC</span>
                            <span class="stack-bubble stack-4">CP</span>
                        </div>
                        <span class="drawer-count-pill">Sẵn sàng</span>
                    </div>
                    <div class="d-flex align-center justify-space-between mt-2" style="position:relative; z-index:2;">
                        <div class="d-flex align-center">
                            <span class="status-indicator-dot online"></span>
                            <span class="drawer-footer-text ml-2">Hệ thống sẵn sàng</span>
                        </div>
                        <span class="drawer-version-tag">v1.0.2</span>
                    </div>
                    <svg class="drawer-wave-svg" viewBox="0 0 300 90" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path d="M-20 75 C 50 20, 120 95, 200 40 C 250 10, 285 55, 320 25" stroke="rgba(45, 212, 191, 0.28)" stroke-width="2" fill="none"/>
                        <path d="M-20 85 C 60 35, 135 100, 215 48 C 260 22, 290 62, 320 38" stroke="rgba(250, 204, 21, 0.22)" stroke-width="1.5" fill="none"/>
                        <path d="M-20 62 C 40 12, 110 82, 190 28 C 240 0, 275 45, 320 15" stroke="rgba(255, 255, 255, 0.12)" stroke-width="1.2" fill="none"/>
                    </svg>
                </div>
            </MudDrawer>

            <!-- ════════════ MAIN CONTENT ════════════ -->
            <MudMainContent Class="irm-main">
                <MudContainer MaxWidth="MaxWidth.False" Class="irm-main-container">
                    <CascadingValue Value="@auth.User.IsInRole(IrmRoles.Admin)" Name="IsAdmin">
                        @Body
                    </CascadingValue>
                </MudContainer>
            </MudMainContent>

            <!-- Spotlight Search Modal Component -->
            <SpotlightSearch @bind-IsOpen="_spotlightOpen" />
        </MudLayout>
    </Authorized>
    <NotAuthorized>
        <LoginView />
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool _drawerOpen = true;
    [CascadingParameter] private IrmThemeContext Theme { get; set; } = null!;
    private bool _darkMode => Theme.IsDarkMode;
    private bool _compactDensity;
    private bool _spotlightOpen;
    private DotNetObjectReference<MainLayout>? _dotNetRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);

            try
            {
                var density = await JS.InvokeAsync<string>("irmInterop.getDensity");
                _compactDensity = string.Equals(density, "compact", StringComparison.OrdinalIgnoreCase);
                await JS.InvokeVoidAsync("irmInterop.registerShortcutHandler", _dotNetRef);
                await JS.InvokeVoidAsync("irmInterop.initFeedbackSpotlight", false);
            }
            catch (JSException ex)
            {
                // Global shortcuts are progressive enhancement. A stale client-side
                // asset must never terminate the Blazor circuit.
                Logger.LogWarning(ex, "Unable to register the global shortcut handler");
            }

            StateHasChanged();
        }
    }

    private async Task ToggleDensityAsync()
    {
        _compactDensity = !_compactDensity;
        try
        {
            await JS.InvokeAsync<string>("irmInterop.setDensity", _compactDensity ? "compact" : "comfortable");
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "Unable to persist table density preference");
        }
    }

    [JSInvokable]
    public void OpenSpotlight()
    {
        _spotlightOpen = true;
        StateHasChanged();
    }

    private Task ToggleTheme() => Theme.ToggleAsync();

    private async Task OpenFeedbackSurveyHtmlAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("irmInterop.dismissFeedbackSpotlight");
            await JS.InvokeVoidAsync("open", "/PHIEU-KHAO-SAT-GOP-Y.html", "_blank");
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "Unable to open feedback survey page");
        }
    }

    private async Task ReplayFeedbackSpotlightAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("irmInterop.initFeedbackSpotlight", true);
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "Unable to replay feedback spotlight");
        }
    }

    public void Dispose()
    {
        _dotNetRef?.Dispose();
    }
}
