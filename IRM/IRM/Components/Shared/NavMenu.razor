@namespace IRM.Components.Layout
@using Microsoft.AspNetCore.Components.Routing

<MudNavMenu Class="irm-nav-menu" Rounded="true" Margin="Margin.Dense" Color="Color.Primary">
    <!-- ════════════ TỔNG QUAN ════════════ -->
    <div class="nav-group-header">
        <span class="nav-section-label">TỔNG QUAN</span>
    </div>

    <MudNavLink Href="/"
                Match="NavLinkMatch.All"
                Icon="@Icons.Material.Filled.Dashboard"
                Class="irm-nav-link"
                ActiveClass="active"
                OnClick='@(() => NotifyPageChanged("Dashboard"))'>
        <span>Bảng điều khiển</span>
    </MudNavLink>

    <!-- ════════════ QUẢN LÝ DỮ LIỆU ════════════ -->
    <div class="nav-group-header">
        <span class="nav-section-label">HỒ SƠ & DỮ LIỆU</span>
    </div>

    <MudNavLink Href="/foreign-persons"
                Match="NavLinkMatch.Prefix"
                Icon="@Icons.Material.Filled.Badge"
                Class="irm-nav-link"
                ActiveClass="active"
                OnClick='@(() => NotifyPageChanged("Hồ sơ Người nước ngoài"))'>
        <div class="d-flex align-center justify-space-between w-100">
            <span>Hồ sơ Người nước ngoài</span>
            <span class="nav-pill-badge badge-primary">5 Tab</span>
        </div>
    </MudNavLink>

    <MudNavLink Href="/companies"
                Match="NavLinkMatch.Prefix"
                Icon="@Icons.Material.Filled.Business"
                Class="irm-nav-link"
                ActiveClass="active"
                OnClick='@(() => NotifyPageChanged("Quản lý Doanh nghiệp"))'>
        <div class="d-flex align-center justify-space-between w-100">
            <span>Doanh nghiệp</span>
            <span class="nav-pill-badge badge-secondary">FDI/KKT</span>
        </div>
    </MudNavLink>

    <MudNavLink Href="/accommodations"
                Match="NavLinkMatch.Prefix"
                Icon="@Icons.Material.Filled.Hotel"
                Class="irm-nav-link"
                ActiveClass="active"
                OnClick='@(() => NotifyPageChanged("Cơ sở lưu trú"))'>
        <span>Cơ sở lưu trú</span>
    </MudNavLink>

    <!-- ════════════ GIÁM SÁT & KIỂM TRA ════════════ -->
    <div class="nav-group-header">
        <span class="nav-section-label">GIÁM SÁT & KIỂM TRA</span>
    </div>

    <MudNavLink Href="/inspections"
                Match="NavLinkMatch.Prefix"
                Icon="@Icons.Material.Filled.FactCheck"
                Class="irm-nav-link"
                ActiveClass="active"
                OnClick='@(() => NotifyPageChanged("Kiểm tra NNN"))'>
        <div class="d-flex align-center justify-space-between w-100">
            <span>Đợt kiểm tra NNN</span>
            <span class="nav-pill-badge badge-warning">Hiện trường</span>
        </div>
    </MudNavLink>

    <!-- ════════════ BÁO CÁO & THỐNG KÊ ════════════ -->
    <div class="nav-group-header">
        <span class="nav-section-label">BÁO CÁO & THỐNG KÊ</span>
    </div>

    <MudNavLink Href="/search"
                Match="NavLinkMatch.Prefix"
                Icon="@Icons.Material.Filled.Search"
                Class="irm-nav-link"
                ActiveClass="active"
                OnClick='@(() => NotifyPageChanged("Tìm kiếm"))'>
        <div class="d-flex align-center justify-space-between w-100">
            <span>Tra cứu toàn cục</span>
            <span class="nav-key-hint">Ctrl+K</span>
        </div>
    </MudNavLink>

    <MudNavLink Href="/reports"
                Match="NavLinkMatch.Prefix"
                Icon="@Icons.Material.Filled.Assessment"
                Class="irm-nav-link"
                ActiveClass="active"
                OnClick='@(() => NotifyPageChanged("Báo cáo"))'>
        <span>Báo cáo định kỳ</span>
    </MudNavLink>

    <MudNavLink Href="/statistics"
                Match="NavLinkMatch.Prefix"
                Icon="@Icons.Material.Filled.BarChart"
                Class="irm-nav-link"
                ActiveClass="active"
                OnClick='@(() => NotifyPageChanged("Thống kê"))'>
        <div class="d-flex align-center justify-space-between w-100">
            <span>Thống kê 54 địa bàn</span>
            <span class="nav-pill-badge badge-cyan">v1.0.2</span>
        </div>
    </MudNavLink>

    <MudNavLink Href="/import"
                Match="NavLinkMatch.Prefix"
                Icon="@Icons.Material.Filled.UploadFile"
                Class="irm-nav-link"
                ActiveClass="active"
                OnClick='@(() => NotifyPageChanged("Import Excel"))'>
        <span>Nhập dữ liệu Excel</span>
    </MudNavLink>

    <!-- ════════════ HỆ THỐNG ════════════ -->
    <AuthorizeView Roles="ADMIN" Context="adminCtx">
        <!-- ──── DANH MỤC (collapsible) ──── -->
        <div class="nav-group-header">
            <span class="nav-section-label">DANH MỤC</span>
        </div>

        <MudNavGroup Title="Danh mục hệ thống"
                     Icon="@Icons.Material.Filled.ListAlt"
                     Class="irm-nav-link"
                     Expanded="false">
            <MudNavLink Href="/admin/nationalities"
                        Match="NavLinkMatch.All"
                        Icon="@Icons.Material.Filled.Public"
                        Class="irm-nav-link"
                        OnClick='@(() => NotifyPageChanged("Quốc tịch"))'>
                <span>Quốc tịch</span>
            </MudNavLink>
            <MudNavLink Href="/admin/districts"
                        Match="NavLinkMatch.All"
                        Icon="@Icons.Material.Filled.Map"
                        Class="irm-nav-link"
                        OnClick='@(() => NotifyPageChanged("Quận / Huyện"))'>
                <span>Quận / Huyện</span>
            </MudNavLink>
            <MudNavLink Href="/admin/wards"
                        Match="NavLinkMatch.All"
                        Icon="@Icons.Material.Filled.Place"
                        Class="irm-nav-link"
                        OnClick='@(() => NotifyPageChanged("Phường / Xã"))'>
                <span>Phường / Xã</span>
            </MudNavLink>
            <MudNavLink Href="/admin/fields"
                        Match="NavLinkMatch.All"
                        Icon="@Icons.Material.Filled.Business"
                        Class="irm-nav-link"
                        OnClick='@(() => NotifyPageChanged("Lĩnh vực"))'>
                <span>Lĩnh vực</span>
            </MudNavLink>
            <MudNavLink Href="/admin/careers"
                        Match="NavLinkMatch.All"
                        Icon="@Icons.Material.Filled.Work"
                        Class="irm-nav-link"
                        OnClick='@(() => NotifyPageChanged("Ngành nghề"))'>
                <span>Ngành nghề</span>
            </MudNavLink>
            <MudNavLink Href="/admin/admin-units"
                        Match="NavLinkMatch.All"
                        Icon="@Icons.Material.Filled.LocationCity"
                        Class="irm-nav-link"
                        OnClick='@(() => NotifyPageChanged("Địa bàn hành chính"))'>
                <span>Địa bàn hành chính</span>
            </MudNavLink>
        </MudNavGroup>

        <!-- ──── QUẢN TRỊ ──── -->
        <div class="nav-group-header">
            <span class="nav-section-label">HỆ THỐNG</span>
        </div>

        <MudNavLink Href="/admin"
                    Match="NavLinkMatch.All"
                    Icon="@Icons.Material.Filled.AdminPanelSettings"
                    Class="irm-nav-link"
                    ActiveClass="active"
                    OnClick='@(() => NotifyPageChanged("Quản trị"))'>
            <span>Quản trị hệ thống</span>
        </MudNavLink>

        <MudNavLink Href="/admin/legacy-sync"
                    Match="NavLinkMatch.All"
                    Icon="@Icons.Material.Filled.Storage"
                    Class="irm-nav-link"
                    ActiveClass="active"
                    OnClick='@(() => NotifyPageChanged("Đồng bộ DB cũ"))'>
            <span>Đồng bộ DB cũ</span>
        </MudNavLink>
    </AuthorizeView>
</MudNavMenu>

@code {
    [Parameter]
    public EventCallback<string> OnPageChanged { get; set; }

    private async Task NotifyPageChanged(string title)
    {
        await OnPageChanged.InvokeAsync(title);
    }
}
