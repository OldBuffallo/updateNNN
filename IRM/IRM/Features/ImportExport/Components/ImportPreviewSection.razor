@namespace IRM.Components.Pages
@inherits IRM.Components.Shared.FeatureSection<Import>

@* Step 3: Preview *@
    @if (Page._currentStep == 3)
    {
        <MudCheckBox T="bool" Value="Page._allowCreateCompanies" ValueChanged="Page.ToggleCompanyCreationAsync"
                     Disabled="Page._isProcessing" Label="Cho phép tạo công ty chưa có từ cột Công ty" />
        var newCount = Page._previewRows.Count(r => r.Status == "new");
        var changedCount = Page._previewRows.Count(r => r.Status == "changed");
        var unchangedCount = Page._previewRows.Count(r => r.Status == "unchanged");
        var errorCount = Page._previewRows.Count(r => r.Status == "error");
        var warningRowCount = Page._previewRows.Count(r => r.Warnings.Count > 0);
        var summarySeverity = errorCount > 0 ? Severity.Error : warningRowCount > 0 ? Severity.Warning : Severity.Success;
        <MudAlert Severity="@summarySeverity" Class="mb-3" data-import-tour="preview-summary">
            Tổng: <strong>@Page._previewRows.Count</strong> dòng ·
            <strong>@newCount</strong> mới ·
            <strong>@changedCount</strong> cập nhật ·
            <strong>@unchangedCount</strong> không đổi ·
            <strong>@warningRowCount cảnh báo</strong> ·
            <strong>@errorCount lỗi</strong>
        </MudAlert>

        <MudSimpleTable Dense="true" Hover="true" Class="rounded-lg border-solid border mb-3" Style="border-width: 1px; max-height: 460px; overflow-y: auto;" data-import-tour="preview-table">
            <thead><tr><th>Dòng</th><th>TT</th><th>Họ tên &amp; Cảnh báo</th><th>Quốc tịch</th><th>Hộ chiếu</th><th>Công ty</th><th>Nghề nghiệp</th><th>GPLĐ</th><th>Xử lý / Lỗi</th></tr></thead>
            <tbody>
                @foreach (var row in Page._previewRows)
                {
                    var rowBg = row.Status switch
                    {
                        "changed" => "background: var(--mud-palette-warning-hover);",
                        "error" => "background: var(--mud-palette-error-hover);",
                        _ => row.Warnings.Count > 0 ? "background: rgba(255, 193, 7, 0.06);" : ""
                    };
                    var chipColor = row.Status switch
                    {
                        "new" => Color.Success,
                        "unchanged" => Color.Info,
                        "changed" => Color.Warning,
                        _ => Color.Error
                    };
                    var chipLabel = row.Status switch
                    {
                        "new" => "Mới",
                        "unchanged" => "Đã có sẵn",
                        "changed" => "Có thay đổi",
                        _ => "Lỗi"
                    };
                    <tr style="@rowBg">
                        <td>@row.RowNumber</td>
                        <td><MudChip T="string" Size="Size.Small" Color="@chipColor">@chipLabel</MudChip></td>
                        <td>
                            <div>@(string.IsNullOrWhiteSpace(row.StaffName) ? "(Chưa có tên)" : row.StaffName)</div>
                            @if (row.Warnings.Count > 0)
                            {
                                <div class="mt-1 d-flex flex-column gap-1" data-import-row-warnings="@row.RowNumber">
                                    @foreach (var warning in row.Warnings)
                                    {
                                        <div class="d-flex align-center gap-1" style="color: var(--mud-palette-warning-darken); font-size: 0.78rem;">
                                            <MudIcon Icon="@Icons.Material.Outlined.WarningAmber" Size="Size.Small" Color="Color.Warning" />
                                            <span>@warning</span>
                                        </div>
                                    }
                                </div>
                            }
                        </td>
                        <td>@row.NationalityDisplay</td>
                        <td><code>@row.Passport</code></td>
                        <td>
                            @if (row.CompanyDisplay != null)
                            {
                                @if (row.ExtendedFields.ContainsKey("__AutoCreateCompanyName"))
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Error">@row.CompanyDisplay</MudText>
                                }
                                else
                                {
                                    <MudText Typo="Typo.caption">@row.CompanyDisplay</MudText>
                                }
                            }
                        </td>
                        <td>@row.CareerDisplay</td>
                        <td>@row.WorkPermitDisplay</td>
                        <td>
                            @if (row.Status == "changed" && row.ExistingEmployeeId.HasValue)
                            {
                                <MudSelect T="string" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined"
                                           Value="@Page.GetDuplicateDecision(row.ExistingEmployeeId.Value)"
                                           ValueChanged="@(val => Page.SetDuplicateDecision(row.ExistingEmployeeId.Value, val))"
                                           Style="min-width: 120px;">
                                    <MudSelectItem Value="@("update")">Cập nhật</MudSelectItem>
                                    <MudSelectItem Value="@("skip")">Bỏ qua</MudSelectItem>
                                </MudSelect>
                            }
                            else if (row.Status == "unchanged")
                            {
                                <MudText Typo="Typo.caption">Thông tin đã có sẵn — bỏ qua</MudText>
                            }
                            else if (row.Status == "error")
                            {
                                <MudText Typo="Typo.caption" Color="Color.Error" Style="white-space: pre-line;">@row.ErrorMessage</MudText>
                            }
                            else
                            {
                                <MudText Typo="Typo.caption" Color="Color.Success">Sẽ thêm mới</MudText>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>

        @if (Page._previewRows.Any(row => row.Status != "error"))
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
                <strong>Dữ liệu cũ được giữ lại.</strong> Hoàn tác theo thứ tự phiên liên quan; dữ liệu đã chỉnh sửa sau import cần được kiểm tra trước.
            </MudAlert>
        }
        else
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">
                Không có dòng hợp lệ để import. Hãy sửa các lỗi phía trên trước khi tiếp tục.
            </MudAlert>
        }

        <MudStack Row="true" Justify="Justify.Center" Spacing="3">
            <MudButton Variant="Variant.Outlined" OnClick="@(() => Page._currentStep = 2)" StartIcon="@Icons.Material.Outlined.ArrowBack" data-import-tour-control="true">Quay lại</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                       OnClick="Page.ExecuteImport" StartIcon="@Icons.Material.Outlined.FlashOn" data-import-tour="execute-import"
                       Disabled="@(Page._isProcessing || !Page._previewRows.Any(row => row.Status != "error"))">
                @if (Page._isProcessing) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                Bắt đầu Import
            </MudButton>
        </MudStack>
    }
