@namespace IRM.Components.Pages
@inherits IRM.Components.Shared.FeatureSection<Import>

@* Step 3: Preview & Database Impact Diff *@
@if (Page._currentStep == 3)
{
    var newCount = Page._previewRows.Count(r => r.Status == "new");
    var changedCount = Page._previewRows.Count(r => r.Status == "changed");
    var unchangedCount = Page._previewRows.Count(r => r.Status == "unchanged");
    var errorCount = Page._previewRows.Count(r => r.Status == "error");
    var warningRowCount = Page._previewRows.Count(r => r.Warnings.Count > 0);
    var totalChangedFields = Page._previewRows.Where(r => r.Status == "changed").Sum(r => r.FieldChanges.Count);
    var destructiveClearCount = Page._previewRows.Where(r => r.Status == "changed").Sum(r => r.FieldChanges.Count(f => f.IsDestructiveClear));
    var summarySeverity = errorCount > 0 ? Severity.Error : warningRowCount > 0 ? Severity.Warning : Severity.Success;

    @* 4-Card Database Impact Summary Strip *@
    <div class="irm-import-summary-strip">
        <div class="irm-import-stat-card">
            <span class="irm-import-stat-label">Thêm hồ sơ mới</span>
            <span class="irm-import-stat-value" style="color: var(--mud-palette-success);">+@newCount</span>
            <span class="irm-import-stat-sub">Tạo mới trong cơ sở dữ liệu</span>
        </div>
        <div class="irm-import-stat-card">
            <span class="irm-import-stat-label">Cập nhật hồ sơ hiện có</span>
            <span class="irm-import-stat-value" style="color: var(--mud-palette-warning);">@changedCount</span>
            <span class="irm-import-stat-sub">
                @totalChangedFields trường thay đổi@(destructiveClearCount > 0 ? $" · {destructiveClearCount} ô xóa dữ liệu cũ" : "")
            </span>
        </div>
        <div class="irm-import-stat-card">
            <span class="irm-import-stat-label">Giữ nguyên (bỏ qua)</span>
            <span class="irm-import-stat-value">@unchangedCount</span>
            <span class="irm-import-stat-sub">Không thay đổi dữ liệu trong DB</span>
        </div>
        <div class="irm-import-stat-card">
            <span class="irm-import-stat-label">Dòng bị chặn (lỗi)</span>
            <span class="irm-import-stat-value" style="color: @(errorCount > 0 ? "var(--mud-palette-error)" : "var(--mud-palette-text-primary)");">@errorCount</span>
            <span class="irm-import-stat-sub">@warningRowCount dòng có cảnh báo nhẹ</span>
        </div>
    </div>

    <MudAlert Severity="@summarySeverity" Dense="true" Class="mb-3" data-import-tour="preview-summary">
        Tổng: <strong>@Page._previewRows.Count</strong> dòng ·
        <strong>@newCount</strong> mới ·
        <strong>@changedCount</strong> cập nhật ·
        <strong>@unchangedCount</strong> không đổi ·
        <strong>@warningRowCount cảnh báo</strong> ·
        <strong>@errorCount lỗi</strong>
    </MudAlert>

    @* Filter Chips + Company Auto-Create Option *@
    <div class="d-flex align-center justify-space-between flex-wrap gap-2 mb-3">
        <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
            <MudChip T="string" Size="Size.Small" Color="@(_statusFilter == "all" ? Color.Primary : Color.Default)"
                     OnClick='() => _statusFilter = "all"'>Tất cả (@Page._previewRows.Count)</MudChip>
            <MudChip T="string" Size="Size.Small" Color="@(_statusFilter == "changed" ? Color.Warning : Color.Default)"
                     OnClick='() => _statusFilter = "changed"'>Sẽ cập nhật (@changedCount)</MudChip>
            <MudChip T="string" Size="Size.Small" Color="@(_statusFilter == "new" ? Color.Success : Color.Default)"
                     OnClick='() => _statusFilter = "new"'>Thêm mới (@newCount)</MudChip>
            <MudChip T="string" Size="Size.Small" Color="@(_statusFilter == "warning" ? Color.Warning : Color.Default)"
                     OnClick='() => _statusFilter = "warning"'>Cảnh báo (@warningRowCount)</MudChip>
            <MudChip T="string" Size="Size.Small" Color="@(_statusFilter == "error" ? Color.Error : Color.Default)"
                     OnClick='() => _statusFilter = "error"'>Bị lỗi (@errorCount)</MudChip>
        </MudStack>
        <MudCheckBox T="bool" Dense="true" Value="Page._allowCreateCompanies" ValueChanged="Page.ToggleCompanyCreationAsync"
                     Disabled="Page._isProcessing" Label="Cho phép tạo công ty chưa có từ cột Công ty" />
    </div>

    <MudSimpleTable Dense="true" Hover="true" Class="irm-data-table rounded-lg border-solid border mb-3" Style="border-width: 1px; max-height: 480px; overflow-y: auto;" data-import-tour="preview-table">
        <thead>
            <tr>
                <th>Dòng</th>
                <th>Trạng thái</th>
                <th>Hồ sơ &amp; Thay đổi dữ liệu DB</th>
                <th>Quốc tịch</th>
                <th>Hộ chiếu</th>
                <th>Công ty</th>
                <th>Nghề nghiệp</th>
                <th>GPLĐ</th>
                <th>Xử lý / Lỗi</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in FilteredPreviewRows)
            {
                var rowBg = row.Status switch
                {
                    "changed" => "background: var(--mud-palette-warning-hover);",
                    "error" => "background: var(--mud-palette-error-hover);",
                    _ => row.Warnings.Count > 0 ? "background: var(--mud-palette-action-default-hover);" : ""
                };
                var chipColor = row.Status switch
                {
                    "new" => Color.Success,
                    "unchanged" => Color.Info,
                    "changed" => Color.Warning,
                    _ => Color.Error
                };
                var chipLabel = row.Status switch
                {
                    "new" => "Mới",
                    "unchanged" => "Đã có sẵn",
                    "changed" => "Có thay đổi",
                    _ => "Lỗi"
                };
                <tr style="@rowBg">
                    <td><span class="code-pill">@row.RowNumber</span></td>
                    <td><MudChip T="string" Size="Size.Small" Color="@chipColor" Variant="Variant.Outlined">@chipLabel</MudChip></td>
                    <td>
                        <div class="cell-primary">@(string.IsNullOrWhiteSpace(row.StaffName) ? "(Chưa có tên)" : row.StaffName)</div>
                        @if (row.FieldChanges.Count > 0)
                        {
                            <div class="irm-diff-list" data-import-row-diffs="@row.RowNumber">
                                @foreach (var diff in row.FieldChanges)
                                {
                                    <div class="irm-diff-pair">
                                        <span class="irm-diff-field-label">@diff.FieldLabel:</span>
                                        <span class="irm-diff-old">@diff.OldValue</span>
                                        <span class="irm-diff-arrow">→</span>
                                        @if (diff.IsDestructiveClear)
                                        {
                                            <span class="irm-diff-clear">@diff.NewValue (xóa dữ liệu cũ)</span>
                                        }
                                        else
                                        {
                                            <span class="irm-diff-new">@diff.NewValue</span>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        @if (row.Warnings.Count > 0)
                        {
                            <div class="mt-1 d-flex flex-column gap-1" data-import-row-warnings="@row.RowNumber">
                                @foreach (var warning in row.Warnings)
                                {
                                    <div class="d-flex align-center gap-1" style="color: var(--mud-palette-warning-darken); font-size: 0.78rem;">
                                        <MudIcon Icon="@Icons.Material.Outlined.WarningAmber" Size="Size.Small" Color="Color.Warning" />
                                        <span>@warning</span>
                                    </div>
                                }
                            </div>
                        }
                    </td>
                    <td>@row.NationalityDisplay</td>
                    <td><span class="code-pill">@row.Passport</span></td>
                    <td>
                        @if (row.CompanyDisplay != null)
                        {
                            @if (row.ExtendedFields.ContainsKey("__AutoCreateCompanyName"))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Error">@row.CompanyDisplay</MudText>
                            }
                            else
                            {
                                <MudText Typo="Typo.caption">@row.CompanyDisplay</MudText>
                            }
                        }
                    </td>
                    <td>@row.CareerDisplay</td>
                    <td>@row.WorkPermitDisplay</td>
                    <td>
                        @if (row.Status == "changed" && row.ExistingEmployeeId.HasValue)
                        {
                            <MudSelect T="string" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined"
                                       Value="@Page.GetDuplicateDecision(row.ExistingEmployeeId.Value)"
                                       ValueChanged="@(val => Page.SetDuplicateDecision(row.ExistingEmployeeId.Value, val))"
                                       Style="min-width: 120px;">
                                <MudSelectItem Value="@("update")">Cập nhật</MudSelectItem>
                                <MudSelectItem Value="@("skip")">Bỏ qua</MudSelectItem>
                            </MudSelect>
                        }
                        else if (row.Status == "unchanged")
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Đã có sẵn — bỏ qua</MudText>
                        }
                        else if (row.Status == "error")
                        {
                            <MudText Typo="Typo.caption" Color="Color.Error" Style="white-space: pre-line;">@row.ErrorMessage</MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Color="Color.Success">Sẽ thêm mới</MudText>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>

    @if (Page._previewRows.Any(row => row.Status != "error"))
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mb-3">
            <strong>An toàn hoàn tác:</strong> Hệ thống tự động sao lưu bản ghi cũ trước khi cập nhật. Bạn có thể hoàn tác phiên import trong mục Lịch sử Import nếu cần.
        </MudAlert>
    }
    else
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mb-3">
            Không có dòng hợp lệ nào để lưu. Hãy quay lại Bước 2 kiểm tra tab <strong>Cần bạn sửa</strong> hoặc sửa file nguồn.
        </MudAlert>
    }

    <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
        <MudButton Variant="Variant.Outlined" Size="Size.Medium" OnClick="@(() => Page._currentStep = 2)" StartIcon="@Icons.Material.Outlined.ArrowBack" data-import-tour-control="true">Quay lại chuẩn hóa</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Medium"
                   OnClick="Page.ExecuteImport" StartIcon="@Icons.Material.Outlined.CheckCircle" data-import-tour="execute-import"
                   Disabled="@(Page._isProcessing || !Page._previewRows.Any(r => r.Status != "error"))">
            @if (Page._isProcessing) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
            Xác nhận Import (@Page._previewRows.Count(r => r.Status == "new" || (r.Status == "changed" && (!r.ExistingEmployeeId.HasValue || Page.GetDuplicateDecision(r.ExistingEmployeeId.Value) == "update"))) dòng)
        </MudButton>
    </MudStack>
}

@code {
    private string _statusFilter = "all";

    private IEnumerable<ImportPreviewRowDto> FilteredPreviewRows => _statusFilter switch
    {
        "new" => Page._previewRows.Where(r => r.Status == "new"),
        "changed" => Page._previewRows.Where(r => r.Status == "changed"),
        "warning" => Page._previewRows.Where(r => r.Warnings.Count > 0),
        "error" => Page._previewRows.Where(r => r.Status == "error"),
        _ => Page._previewRows
    };
}
