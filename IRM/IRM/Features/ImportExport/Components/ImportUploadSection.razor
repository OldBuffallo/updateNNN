@namespace IRM.Components.Pages
@inherits IRM.Components.Shared.FeatureSection<Import>

@* Step 1: Upload *@
    @if (Page._currentStep == 1)
    {
        @if (!Page._hasCompanies)
        {
            <MudAlert Severity="Severity.Info" Class="mb-3">
                <strong>Chưa có công ty nào trong hệ thống.</strong> Nếu file Excel có cột <strong>"Công ty"</strong> hoặc <strong>"CQ bảo lãnh"</strong>, cần bật rõ tùy chọn cho phép tạo công ty trước khi xem trước.
                <MudButton Href="/companies" Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" Class="ml-3">
                    Quản lý công ty
                </MudButton>
            </MudAlert>
        }

        <MudPaper Elevation="0" Class="pa-8 rounded-xl border-dashed border-2 text-center"
                  Style="border-color: var(--mud-palette-primary);">
            <MudIcon Icon="@Icons.Material.Outlined.CloudUpload" Size="Size.Large"
                     Style="font-size: 3rem; opacity: 0.4;" Color="Color.Primary" />
            <MudText Typo="Typo.h6" Class="mt-3" Style="font-weight: 700;">Kéo thả file Excel vào đây</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">
                hoặc nhấn nút bên dưới để chọn file
            </MudText>
            <MudText Typo="Typo.caption" Color="Color.Tertiary" Class="mt-2">.xlsx — Tệp Excel theo mẫu IRM hoặc xuất từ WPF</MudText>

            <MudStack AlignItems="AlignItems.Center" Class="mt-4">
                <InputFile OnChange="Page.HandleFileUpload" accept=".xlsx" id="fileInput" style="display:none" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" HtmlTag="label" for="fileInput"
                           StartIcon="@Icons.Material.Outlined.AttachFile">
                    Chọn file Excel
                </MudButton>
            </MudStack>

            @if (!string.IsNullOrEmpty(Page._uploadedFileName))
            {
                <MudAlert Severity="Severity.Success" Dense="true" Class="mt-3">
                    Đã chọn: <strong>@Page._uploadedFileName</strong> — @Page._sheetInfo
                </MudAlert>
            }
        </MudPaper>

        <MudGrid Spacing="3" Class="mt-3">
            <MudItem xs="6">
                <MudAutocomplete T="CompanyDto" @bind-Value="Page._selectedCompany" Label="Công ty mặc định (dùng khi file không có cột Công ty)"
                                 SearchFunc="Page.SearchCompanyAsync" ToStringFunc="@(c => c?.CompanyName ?? "")"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                                 ResetValueOnEmptyText="true" Immediate="true" />
            </MudItem>
            <MudItem xs="6">
                <MudSelect T="int?" Label="Template ghép cột" Variant="Variant.Outlined" @bind-Value="Page._selectedTemplateId"
                           Margin="Margin.Dense" Dense="true">
                    <MudSelectItem T="int?" Value="@((int?)null)">— Không dùng template —</MudSelectItem>
                    @foreach (var t in Page._templates)
                    {
                        <MudSelectItem T="int?" Value="@((int?)t.Id)">@t.TemplateName</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        </MudGrid>

        <MudGrid Spacing="3" Class="mt-3">
            <MudItem xs="12" md="6">
                <MudSelect T="int" Label="Sheet" @bind-Value="Page._sheetIndex" Variant="Variant.Outlined">
                    @for (var index = 0; index < Page._sheetNames.Count; index++)
                    {
                        var sheetIndex = index;
                        <MudSelectItem T="int" Value="sheetIndex">@Page._sheetNames[sheetIndex]</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudSelect T="int" Label="Nhóm nghề (bắt buộc)" @bind-Value="Page._careerGroupId" Variant="Variant.Outlined">
                    @foreach (var group in Page._careerGroups)
                    {
                        <MudSelectItem T="int" Value="group.IDCG">@group.CareerGroupName</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="4"><MudNumericField T="int" Label="Dòng tiêu đề (0: tự tìm)" Min="0" @bind-Value="Page._headerRow" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="4"><MudNumericField T="int" Label="Dòng dữ liệu đầu (0: sau tiêu đề)" Min="0" @bind-Value="Page._startRow" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="4"><MudNumericField T="int?" Label="Dòng dữ liệu cuối (trống: hết sheet)" Min="1" @bind-Value="Page._endRow" Variant="Variant.Outlined" /></MudItem>
        </MudGrid>
        <MudCheckBox T="bool" @bind-Value="Page._allowCreateCompanies" Label="Cho phép tạo công ty chưa có từ cột Công ty; kiểm tra danh sách ở bước xem trước" />

        <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3">
            <strong>An toàn dữ liệu:</strong> Mỗi lần import tạo phiên riêng. Có thể <strong>hoàn tác</strong> từ Lịch sử Import khi dữ liệu chưa bị chỉnh sửa hoặc thay thế bởi phiên liên quan mới hơn.
        </MudAlert>
        <MudAlert Severity="Severity.Success" Dense="true" Class="mt-2">
            <strong>Tự động ghép công ty:</strong> Nếu file Excel có cột <strong>"Công ty"</strong> hoặc <strong>"CQ bảo lãnh"</strong>, hệ thống sẽ tự động ghép công ty theo từng dòng. Công ty chưa có chỉ được tạo khi bạn bật tùy chọn bên dưới.
        </MudAlert>

        <MudStack Row="true" Justify="Justify.Center" Class="mt-4">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                       EndIcon="@Icons.Material.Outlined.ArrowForward"
                       Disabled="@(Page._fileStream == null || Page._careerGroupId <= 0)"
                       OnClick="Page.GoToStep2">Tiếp tục</MudButton>
        </MudStack>
    }
