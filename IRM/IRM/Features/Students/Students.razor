@namespace IRM.Components.Pages

@using IRM.Services
@using IRM.Data.Models
@inject IStudentService StudentSvc
@inject ICatalogService CatalogSvc
@inject IExportService ExportSvc
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<PageTitle>Du học sinh - IRM v1.0.2</PageTitle>

<div class="section-header">
    <h3>Danh sách Du học sinh</h3>
    <span class="section-meta">
        @if (_showExpiring)
        {
            <text>Tổng: @_students.Count du học sinh sắp hết hạn visa</text>
        }
        else
        {
            <text>Tổng: @_students.Count du học sinh</text>
        }
    </span>
</div>

<div class="page-actions-bar">
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Style="flex-wrap:wrap;">
        <MudSelect T="string" @bind-Value="_fltNationality" @bind-Value:after="ApplyFilters"
                   Placeholder="Quốc tịch" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Style="min-width:150px;">
            @foreach (var n in _nationalities)
            {
                <MudSelectItem Value="@n.NationalityCode">@n.NationalityName</MudSelectItem>
            }
        </MudSelect>
        <MudTextField T="string" @bind-Value="_fltSchool" @bind-Value:after="ApplyFilters"
                      Placeholder="Trường" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Style="min-width:180px;" />
        <MudTextField T="string" @bind-Value="_fltMajor" @bind-Value:after="ApplyFilters"
                      Placeholder="Ngành" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Style="min-width:150px;" />
        <MudSelect T="EducationLevel?" @bind-Value="_fltEdu" @bind-Value:after="ApplyFilters"
                   Placeholder="Trình độ" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Style="min-width:130px;">
            <MudSelectItem T="EducationLevel?" Value="EducationLevel.University">Đại học</MudSelectItem>
            <MudSelectItem T="EducationLevel?" Value="EducationLevel.Master">Thạc sĩ</MudSelectItem>
            <MudSelectItem T="EducationLevel?" Value="EducationLevel.Doctorate">Tiến sĩ</MudSelectItem>
            <MudSelectItem T="EducationLevel?" Value="EducationLevel.ShortTerm">Ngắn hạn</MudSelectItem>
            <MudSelectItem T="EducationLevel?" Value="EducationLevel.Other">Khác</MudSelectItem>
        </MudSelect>
        <MudSelect T="ScholarshipType?" @bind-Value="_fltScholarship" @bind-Value:after="ApplyFilters"
                   Placeholder="Học bổng" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Style="min-width:150px;">
            <MudSelectItem T="ScholarshipType?" Value="ScholarshipType.SelfFunded">Tự túc</MudSelectItem>
            <MudSelectItem T="ScholarshipType?" Value="ScholarshipType.VietnamGovernment">HB Chính phủ VN</MudSelectItem>
            <MudSelectItem T="ScholarshipType?" Value="ScholarshipType.ForeignScholarship">HB nước ngoài</MudSelectItem>
            <MudSelectItem T="ScholarshipType?" Value="ScholarshipType.Other">Khác</MudSelectItem>
        </MudSelect>
        <MudSelect T="StudentStatus?" @bind-Value="_fltStatus" @bind-Value:after="ApplyFilters"
                   Placeholder="Trạng thái" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Style="min-width:140px;">
            <MudSelectItem T="StudentStatus?" Value="StudentStatus.Studying">Đang học</MudSelectItem>
            <MudSelectItem T="StudentStatus?" Value="StudentStatus.Graduated">Đã TN</MudSelectItem>
            <MudSelectItem T="StudentStatus?" Value="StudentStatus.OnLeave">Tạm nghỉ</MudSelectItem>
            <MudSelectItem T="StudentStatus?" Value="StudentStatus.Returned">Đã về nước</MudSelectItem>
        </MudSelect>
    </MudStack>
    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2">
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Download" Color="Color.Default" OnClick="ExportExcelAsync">Xuất Excel</MudButton>
        <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Outlined.PersonAdd" Color="Color.Primary" OnClick="OpenAddDialog">Thêm DHS</MudButton>
    </MudStack>
</div>

<MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2" Class="mb-3">
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="LoadAllAsync" Size="Size.Small">Tất cả</MudButton>
    <MudButton Variant="@(_showExpiring ? Variant.Filled : Variant.Outlined)" Color="Color.Warning" OnClick="LoadExpiringAsync" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Warning">Sắp hết hạn visa</MudButton>
</MudStack>

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}

@if (_students.Any())
{
    <MudDataGrid Items="@_students" T="StudentDto" Breakpoint="Breakpoint.None" Filterable="true" Hover="true" Striped="true" Class="irm-data-table" RowsPerPage="10" Elevation="0">
        <Columns>
            <TemplateColumn Title="STT" Sortable="false" Filterable="false" HeaderStyle="text-align: center;" CellStyle="width: 60px; text-align: center;">
                <CellTemplate><span class="cell-secondary font-weight-bold tabular-nums">@(_students.IndexOf(context.Item) + 1)</span></CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Du học sinh" SortBy="@(x => x.FullName)">
                <CellTemplate>
                    <div class="cell-inline" title="@context.Item.FullName">
                        <span class="cell-primary">@context.Item.FullName</span>
                        <span class="cell-secondary tabular-nums">
                            · @context.Item.GenderString@(context.Item.Birthday.HasValue ? $", {context.Item.Birthday.Value:yyyy}" : "")
                        </span>
                    </div>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Hộ chiếu" SortBy="@(x => x.Passport)">
                <CellTemplate>
                    <span class="code-pill">@(string.IsNullOrWhiteSpace(context.Item.Passport) ? "—" : context.Item.Passport)</span>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Quốc tịch" SortBy="@(x => x.Nationality)">
                <CellTemplate>
                    <span class="cell-secondary">@(context.Item.NationalityNav?.NationalityName ?? context.Item.Nationality ?? "—")</span>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Trường & Ngành học" SortBy="@(x => x.SchoolName)">
                <CellTemplate>
                    <div class="cell-truncate" title="@context.Item.SchoolName">
                        <span class="cell-primary">@(context.Item.SchoolName ?? "—")</span>
                        @if (!string.IsNullOrWhiteSpace(context.Item.Major))
                        {
                            <span class="cell-secondary"> · @context.Item.Major</span>
                        }
                    </div>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Trình độ & Diện">
                <CellTemplate>
                    <span class="cell-secondary">@context.Item.EducationLevelString · @context.Item.ScholarshipTypeString</span>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Hạn Visa" SortBy="@(x => x.DaysUntilVisaExpiry ?? int.MaxValue)" HeaderStyle="text-align: right;" CellStyle="text-align: right;">
                <CellTemplate>
                    @if (context.Item.DaysUntilVisaExpiry is int days && context.Item.VisaExpiry.HasValue)
                    {
                        var statusClass = days <= 7 ? "status-urgent" : days <= 30 ? "status-warning" : "status-safe";
                        <span class="status-pill @statusClass tabular-nums">
                            <span class="status-dot"></span>
                            <span class="code-pill">@context.Item.VisaExpiry.Value.ToString("dd/MM/yyyy")</span>
                            <span>(@(days >= 0 ? $"{days} ngày" : $"Quá {-days} ngày"))</span>
                        </span>
                    }
                    else
                    {
                        <span class="status-pill status-neutral">Chưa có hạn</span>
                    }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Trạng thái">
                <CellTemplate>
                    @{ var stTag = context.Item.Status switch { StudentStatus.Studying => "tag-green", StudentStatus.Graduated => "tag-blue", StudentStatus.OnLeave => "tag-orange", StudentStatus.Returned => "tag-red", _ => "tag-blue" }; }
                    <span class="tag @stTag">@context.Item.StatusString</span>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Thao tác" Sortable="false" Filterable="false" HeaderClass="col-actions" CellClass="col-actions" HeaderStyle="text-align: right;" CellStyle="text-align: right;">
                <CellTemplate>
                    <MudIconButton Icon="@Icons.Material.Outlined.Visibility" Size="Size.Small" Color="Color.Primary" OnClick="@(() => OpenDetailDialog(context.Item))" />
                    <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" Color="Color.Warning" OnClick="@(() => OpenEditDialog(context.Item))" />
                    <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => ConfirmDelete(context.Item))" />
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <PagerContent><MudDataGridPager T="StudentDto" /></PagerContent>
    </MudDataGrid>
}
else if (!_loading)
{
    <MudPaper Elevation="0" Class="pa-8 rounded-lg text-center empty-state-card">
        <MudText Typo="Typo.h6" Color="Color.Secondary" Class="mb-2">Chưa có du học sinh nào hoặc chọn bộ lọc để xem</MudText>
    </MudPaper>
}

@* ══════ DIALOG THÊM/SỬA ══════ *@
<MudDialog @bind-Visible="_dlgVisible" Options="@(new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true })">
    <TitleContent><MudText Typo="Typo.h6" Style="font-weight:700;">@(_dlgEditing ? "Sửa du học sinh" : "Thêm du học sinh")</MudText></TitleContent>
    <DialogContent>
        <MudGrid Spacing="3">
            <MudItem xs="12" md="6"><MudTextField T="string" Label="Họ tên *" @bind-Value="_f.FullName" Variant="Variant.Outlined" Required="true" RequiredError="Bắt buộc nhập họ tên" Error="@(_dlgSubmitted && string.IsNullOrWhiteSpace(_f.FullName))" ErrorText="Bắt buộc nhập họ tên" /></MudItem>
            <MudItem xs="6" md="3"><MudSelect T="Gender" Label="Giới tính" @bind-Value="_f.Gender" Variant="Variant.Outlined"><MudSelectItem Value="Gender.Male">Nam</MudSelectItem><MudSelectItem Value="Gender.Female">Nữ</MudSelectItem></MudSelect></MudItem>
            <MudItem xs="6" md="3"><MudDatePicker Label="Ngày sinh" @bind-Date="_f.Birthday" Variant="Variant.Outlined" DateFormat="dd/MM/yyyy" /></MudItem>
            <MudItem xs="6" md="4"><MudSelect T="string" Label="Quốc tịch" @bind-Value="_f.Nationality" Variant="Variant.Outlined" Clearable="true">@foreach(var n in _nationalities){<MudSelectItem Value="@n.NationalityCode">@n.NationalityName (@n.NationalityCode)</MudSelectItem>}</MudSelect></MudItem>
            <MudItem xs="6" md="4"><MudTextField T="string" Label="Số hộ chiếu" @bind-Value="_f.Passport" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="4"><MudTextField T="string" Label="Địa chỉ tại VN" @bind-Value="_f.Address" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="6"><MudTextField T="string" Label="Trường *" @bind-Value="_f.SchoolName" Variant="Variant.Outlined" Required="true" RequiredError="Bắt buộc nhập tên trường" Error="@(_dlgSubmitted && string.IsNullOrWhiteSpace(_f.SchoolName))" ErrorText="Bắt buộc nhập tên trường" /></MudItem>
            <MudItem xs="6" md="3"><MudTextField T="string" Label="Ngành học" @bind-Value="_f.Major" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="6" md="3"><MudTextField T="string" Label="Mã sinh viên" @bind-Value="_f.StudentCode" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="6" md="3"><MudSelect T="EducationLevel" Label="Trình độ" @bind-Value="_f.EducationLevel" Variant="Variant.Outlined"><MudSelectItem Value="EducationLevel.University">Đại học</MudSelectItem><MudSelectItem Value="EducationLevel.Master">Thạc sĩ</MudSelectItem><MudSelectItem Value="EducationLevel.Doctorate">Tiến sĩ</MudSelectItem><MudSelectItem Value="EducationLevel.ShortTerm">Ngắn hạn</MudSelectItem><MudSelectItem Value="EducationLevel.Other">Khác</MudSelectItem></MudSelect></MudItem>
            <MudItem xs="6" md="3"><MudSelect T="ScholarshipType" Label="Học bổng" @bind-Value="_f.ScholarshipType" Variant="Variant.Outlined"><MudSelectItem Value="ScholarshipType.SelfFunded">Tự túc</MudSelectItem><MudSelectItem Value="ScholarshipType.VietnamGovernment">HB Chính phủ VN</MudSelectItem><MudSelectItem Value="ScholarshipType.ForeignScholarship">HB nước ngoài</MudSelectItem><MudSelectItem Value="ScholarshipType.Other">Khác</MudSelectItem></MudSelect></MudItem>
            <MudItem xs="6" md="3"><MudDatePicker Label="Ngày nhập học" @bind-Date="_f.EnrollmentDate" Variant="Variant.Outlined" DateFormat="dd/MM/yyyy" /></MudItem>
            <MudItem xs="6" md="3"><MudDatePicker Label="Dự kiến TN" @bind-Date="_f.ExpectedGraduation" Variant="Variant.Outlined" DateFormat="dd/MM/yyyy" /></MudItem>
            <MudItem xs="6" md="4"><MudTextField T="string" Label="Số Visa" @bind-Value="_f.VisaNumber" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="6" md="4"><MudDatePicker Label="Hạn Visa" @bind-Date="_f.VisaExpiry" Variant="Variant.Outlined" DateFormat="dd/MM/yyyy" /></MudItem>
            <MudItem xs="6" md="4"><MudDatePicker Label="Hạn tạm trú" @bind-Date="_f.TemporaryStay" Variant="Variant.Outlined" DateFormat="dd/MM/yyyy" /></MudItem>
            <MudItem xs="6" md="4"><MudSelect T="StudentStatus" Label="Trạng thái" @bind-Value="_f.Status" Variant="Variant.Outlined"><MudSelectItem Value="StudentStatus.Studying">Đang học</MudSelectItem><MudSelectItem Value="StudentStatus.Graduated">Đã tốt nghiệp</MudSelectItem><MudSelectItem Value="StudentStatus.OnLeave">Tạm nghỉ</MudSelectItem><MudSelectItem Value="StudentStatus.Returned">Đã về nước</MudSelectItem></MudSelect></MudItem>
            <MudItem xs="12" md="8"><MudTextField T="string" Label="Ghi chú" @bind-Value="_f.Note" Variant="Variant.Outlined" Lines="2" /></MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="@(() => _dlgVisible = false)">Hủy</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync">@(_dlgEditing ? "Cập nhật" : "Thêm")</MudButton>
    </DialogActions>
</MudDialog>

@* ══════ DIALOG CHI TIẾT ══════ *@
<MudDialog @bind-Visible="_detVisible" Options="@(new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true })">
    <TitleContent><MudText Typo="Typo.h6" Style="font-weight:700;">Hồ sơ du học sinh</MudText></TitleContent>
    <DialogContent>
        @if (_det != null)
        {
            <MudGrid Spacing="2">
                <MudItem xs="12"><MudText Typo="Typo.h5" Style="font-weight:800;">@_det.FullName</MudText></MudItem>
                <MudItem xs="4"><MudText Typo="Typo.caption" Color="Color.Secondary">Giới tính</MudText><MudText Style="font-weight:600;">@_det.GenderString</MudText></MudItem>
                <MudItem xs="4"><MudText Typo="Typo.caption" Color="Color.Secondary">Ngày sinh</MudText><MudText Style="font-weight:600;">@(_det.Birthday?.ToString("dd/MM/yyyy") ?? "—")</MudText></MudItem>
                <MudItem xs="4"><MudText Typo="Typo.caption" Color="Color.Secondary">Quốc tịch</MudText><MudText Style="font-weight:600;">@(_det.NationalityNav?.NationalityName ?? _det.Nationality ?? "—")</MudText></MudItem>
                <MudItem xs="4"><MudText Typo="Typo.caption" Color="Color.Secondary">Hộ chiếu</MudText><MudText Style="font-weight:600;">@(_det.Passport ?? "—")</MudText></MudItem>
                <MudItem xs="4"><MudText Typo="Typo.caption" Color="Color.Secondary">Địa chỉ</MudText><MudText Style="font-weight:600;">@(_det.Address ?? "—")</MudText></MudItem>
                <MudItem xs="4"><MudText Typo="Typo.caption" Color="Color.Secondary">Trạng thái</MudText><span class="tag @(_det.Status == 0 ? "tag-green" : "tag-blue")">@_det.StatusString</span></MudItem>
                <MudItem xs="12"><MudDivider Class="my-1" /><MudText Typo="Typo.subtitle2" Style="font-weight:700;">Thông tin học tập</MudText></MudItem>
                <MudItem xs="4"><MudText Typo="Typo.caption" Color="Color.Secondary">Trường</MudText><MudText Style="font-weight:600;">@(_det.SchoolName ?? "—")</MudText></MudItem>
                <MudItem xs="4"><MudText Typo="Typo.caption" Color="Color.Secondary">Ngành</MudText><MudText Style="font-weight:600;">@(_det.Major ?? "—")</MudText></MudItem>
                <MudItem xs="4"><MudText Typo="Typo.caption" Color="Color.Secondary">Mã SV</MudText><MudText Style="font-weight:600;">@(_det.StudentCode ?? "—")</MudText></MudItem>
                <MudItem xs="4"><MudText Typo="Typo.caption" Color="Color.Secondary">Trình độ</MudText><span class="tag tag-purple">@_det.EducationLevelString</span></MudItem>
                <MudItem xs="4"><MudText Typo="Typo.caption" Color="Color.Secondary">Học bổng</MudText><span class="tag @(_det.ScholarshipType == 0 ? "tag-orange" : "tag-green")">@_det.ScholarshipTypeString</span></MudItem>
                <MudItem xs="4"><MudText Typo="Typo.caption" Color="Color.Secondary">Nhập học</MudText><MudText Style="font-weight:600;">@(_det.EnrollmentDate?.ToString("dd/MM/yyyy") ?? "—")</MudText></MudItem>
                <MudItem xs="12"><MudDivider Class="my-1" /><MudText Typo="Typo.subtitle2" Style="font-weight:700;">Visa & Tạm trú</MudText></MudItem>
                <MudItem xs="4"><MudText Typo="Typo.caption" Color="Color.Secondary">Số Visa</MudText><MudText Style="font-weight:600;">@(_det.VisaNumber ?? "—")</MudText></MudItem>
                <MudItem xs="4"><MudText Typo="Typo.caption" Color="Color.Secondary">Hạn Visa</MudText><MudText Style="font-weight:600;">@(_det.VisaExpiry?.ToString("dd/MM/yyyy") ?? "—")</MudText></MudItem>
                <MudItem xs="4"><MudText Typo="Typo.caption" Color="Color.Secondary">Còn lại</MudText><MudText Style="@GetExpiryStyle(_det)">@(_det.DaysUntilVisaExpiry.HasValue ? $"{_det.DaysUntilVisaExpiry} ngày" : "—")</MudText></MudItem>
            </MudGrid>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="@(() => _detVisible = false)">Đóng</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Warning" StartIcon="@Icons.Material.Outlined.Edit" OnClick="@(() => { _detVisible = false; if (_det != null) OpenEditDialog(_det); })">Sửa</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<StudentDto> _allStudents = new();
    private List<StudentDto> _students = new();
    private bool _loading; private bool _showExpiring;

    // Filters
    private string? _fltNationality; private string? _fltSchool; private string? _fltMajor;
    private EducationLevel? _fltEdu; private ScholarshipType? _fltScholarship; private StudentStatus? _fltStatus;

    // Dialog
    private bool _dlgVisible; private bool _dlgEditing; private bool _dlgSubmitted; private StudentDto _f = new(); private int _dlgEditId;
    private bool _detVisible; private StudentDto? _det;
    private List<NationalityEntityDto> _nationalities = new();

    protected override async Task OnInitializedAsync()
    {
        _nationalities = await CatalogSvc.GetNationalitiesAsync();
        await LoadAllAsync();
    }

    private async Task LoadAllAsync()
    {
        _loading = true; _showExpiring = false;
        try { _allStudents = await StudentSvc.GetAllVisibleAsync(); ApplyFilters(); }
        catch { _allStudents = new(); _students = new(); }
        finally { _loading = false; }
    }

    private async Task LoadExpiringAsync()
    {
        _loading = true; _showExpiring = true;
        try { _allStudents = await StudentSvc.GetExpiringVisaAsync(90); ApplyFilters(); }
        catch { _allStudents = new(); _students = new(); }
        finally { _loading = false; }
    }

    private void ApplyFilters()
    {
        IEnumerable<StudentDto> q = _allStudents;
        if (!string.IsNullOrWhiteSpace(_fltNationality)) q = q.Where(s => s.Nationality == _fltNationality);
        if (!string.IsNullOrWhiteSpace(_fltSchool)) q = q.Where(s => s.SchoolName != null && s.SchoolName.Contains(_fltSchool, StringComparison.OrdinalIgnoreCase));
        if (!string.IsNullOrWhiteSpace(_fltMajor)) q = q.Where(s => s.Major != null && s.Major.Contains(_fltMajor, StringComparison.OrdinalIgnoreCase));
        if (_fltEdu.HasValue) q = q.Where(s => s.EducationLevel == _fltEdu.Value);
        if (_fltScholarship.HasValue) q = q.Where(s => s.ScholarshipType == _fltScholarship.Value);
        if (_fltStatus.HasValue) q = q.Where(s => s.Status == _fltStatus.Value);
        _students = q.ToList();
    }

    private async Task ExportExcelAsync()
    {
        try
        {
            var bytes = await ExportSvc.ExportStudentsAsync(_fltNationality, _fltSchool, _fltEdu, _fltScholarship, _fltStatus, _showExpiring);
            var base64 = Convert.ToBase64String(bytes);
            await JS.InvokeVoidAsync("irmInterop.downloadFile", $"DuHocSinh_{DateTime.Now:yyyyMMdd}.xlsx",
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", base64);
        }
        catch { }
    }

    private void OpenAddDialog()
    {
        _dlgEditing = false; _dlgSubmitted = false; _dlgEditId = 0;
        _f = new StudentDto { Gender = Gender.Male };
        _dlgVisible = true;
    }

    private void OpenEditDialog(StudentDto s)
    {
        _dlgEditing = true; _dlgSubmitted = false; _dlgEditId = s.IDStudent;
        _f = new StudentDto
        {
            FullName = s.FullName, Gender = s.Gender, Birthday = s.Birthday,
            Nationality = s.Nationality, Passport = s.Passport, Address = s.Address,
            SchoolName = s.SchoolName, Major = s.Major, StudentCode = s.StudentCode,
            EducationLevel = s.EducationLevel, EnrollmentDate = s.EnrollmentDate,
            ExpectedGraduation = s.ExpectedGraduation, VisaNumber = s.VisaNumber,
            VisaExpiry = s.VisaExpiry, TemporaryStay = s.TemporaryStay,
            ScholarshipType = s.ScholarshipType, Status = s.Status, Note = s.Note
        };
        _dlgVisible = true;
    }

    private async Task SaveAsync()
    {
        _dlgSubmitted = true;
        if (string.IsNullOrWhiteSpace(_f.FullName)) { Snackbar.Add("Họ tên không được trống", Severity.Error); return; }
        if (string.IsNullOrWhiteSpace(_f.SchoolName)) { Snackbar.Add("Tên trường không được trống", Severity.Error); return; }
        try
        {
            if (_dlgEditing) { _f.IDStudent = _dlgEditId; await StudentSvc.UpdateAsync(_f); Snackbar.Add($"Đã cập nhật \"{_f.FullName}\"", Severity.Success); }
            else { await StudentSvc.CreateAsync(_f); Snackbar.Add($"Đã thêm \"{_f.FullName}\"", Severity.Success); }
            _dlgSubmitted = false;
            _dlgVisible = false; await LoadAllAsync();
        }
        catch (Exception ex) { Snackbar.Add($"Lỗi: {ex.Message}", Severity.Error); }
    }

    private async Task ConfirmDelete(StudentDto s)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Xóa du học sinh \"{s.FullName}\"?");
        if (confirmed) { await StudentSvc.DeleteAsync(s.IDStudent); Snackbar.Add("Đã xóa", Severity.Success); await LoadAllAsync(); }
    }

    private void OpenDetailDialog(StudentDto s) { _det = s; _detVisible = true; }

    private static string GetExpiryStyle(StudentDto s)
    {
        var color = s.DaysUntilVisaExpiry switch { <= 7 => "#dc2626", <= 30 => "#d97706", _ => "#059669" };
        return $"font-weight:700; color:{color};";
    }
}
