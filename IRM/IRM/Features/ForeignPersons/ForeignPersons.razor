@namespace IRM.Components.Pages
@page "/foreign-persons"
@page "/employees"
@page "/students"
@page "/family-visitors"
@using IRM.Data.Models
@using IRM.Services
@inject IForeignerRegistryService Registry
@inject IEmployeeService EmployeeSvc
@inject IStudentService StudentSvc
@inject ICompanyService CompanySvc
@inject ICatalogService Catalog
@inject IExportService ExportSvc
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>Hồ sơ Người nước ngoài - IRM v1.0.2</PageTitle>

<div class="section-header">
    <div class="d-flex align-center justify-space-between flex-wrap gap-2">
        <div>
            <h3>Hồ sơ Người nước ngoài</h3>
            <span class="section-meta">
                Quản lý tập trung mỗi người 1 hồ sơ đa diện · Lao động, Du học sinh, Thăm thân, Giấy tờ XNC & Định danh điện tử
            </span>
        </div>
        <div class="d-flex align-center flex-wrap gap-2">
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Default"
                       StartIcon="@Icons.Material.Outlined.Download"
                       OnClick="ExportExcelAsync">
                Xuất Excel
            </MudButton>
            <AuthorizeView Roles="ADMIN,DATA_EDITOR">
                @if (_items.Any(x => x.IsLegacyUnlinked))
                {
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Outlined.Sync"
                               OnClick="SyncLegacyRecordsAsync">
                        Đồng bộ hồ sơ cũ (@_items.Count(x => x.IsLegacyUnlinked))
                    </MudButton>
                }
            </AuthorizeView>
            <AuthorizeView Roles="ADMIN">
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Error"
                           StartIcon="@Icons.Material.Outlined.DeleteSweep"
                           OnClick="OpenArchiveTemporaryStayDialog">
                    Xóa hết hạn tạm trú
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Error"
                           StartIcon="@Icons.Material.Outlined.FamilyRestroom"
                           OnClick="OpenArchiveFamilyVisitDialog">
                    Xóa hết hạn thăm thân
                </MudButton>
            </AuthorizeView>
            <AuthorizeView Roles="ADMIN,DATA_EDITOR">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Outlined.PersonAdd"
                           OnClick="OpenAddPerson">
                    Thêm hồ sơ NNN
                </MudButton>
            </AuthorizeView>
        </div>
    </div>
</div>

<!-- ════════════ STATS SUMMARY CARDS ════════════ -->
<MudGrid Spacing="2" Class="mb-3">
    <MudItem xs="6" sm="3">
        <div class="stat-mini-card stat-blue" style="cursor:pointer;" @onclick='() => SelectCategory("ALL")'>
            <div class="stat-mini-icon"><MudIcon Icon="@Icons.Material.Outlined.Badge" Size="Size.Small" /></div>
            <div class="stat-mini-data">
                <span class="stat-mini-value">@_items.Count</span>
                <span class="stat-mini-label">Tổng hồ sơ NNN</span>
            </div>
        </div>
    </MudItem>
    <MudItem xs="6" sm="3">
        <div class="stat-mini-card stat-purple" style="cursor:pointer;" @onclick='() => SelectCategory("WORK")'>
            <div class="stat-mini-icon"><MudIcon Icon="@Icons.Material.Outlined.Groups" Size="Size.Small" /></div>
            <div class="stat-mini-data">
                <span class="stat-mini-value">@_items.Count(x => x.HasWorkProfile)</span>
                <span class="stat-mini-label">Lao động nước ngoài</span>
            </div>
        </div>
    </MudItem>
    <MudItem xs="6" sm="3">
        <div class="stat-mini-card stat-amber" style="cursor:pointer;" @onclick='() => SelectCategory("STUDY_FAMILY")'>
            <div class="stat-mini-icon"><MudIcon Icon="@Icons.Material.Outlined.School" Size="Size.Small" /></div>
            <div class="stat-mini-data">
                <span class="stat-mini-value">@_items.Count(x => x.HasStudyProfile) / @_items.Count(x => x.HasFamilyVisitProfile)</span>
                <span class="stat-mini-label">Du học / Thăm thân</span>
            </div>
        </div>
    </MudItem>
    <MudItem xs="6" sm="3">
        <div class="stat-mini-card stat-green">
            <div class="stat-mini-icon"><MudIcon Icon="@Icons.Material.Outlined.VerifiedUser" Size="Size.Small" /></div>
            <div class="stat-mini-data">
                <span class="stat-mini-value">@_items.Count(x => !string.IsNullOrEmpty(x.ElectronicIdNumber))</span>
                <span class="stat-mini-label">Đã ghi nhận định danh ĐT</span>
            </div>
        </div>
    </MudItem>
</MudGrid>

<!-- ════════════ QUICK CATEGORY FILTER TABS ════════════ -->
<MudStack Row="true" Spacing="2" Class="mb-3" Style="flex-wrap:wrap;">
    <MudButton Variant="@(_categoryFilter == "ALL" ? Variant.Filled : Variant.Outlined)"
               Color="@(_categoryFilter == "ALL" ? Color.Primary : Color.Default)"
               Size="Size.Small"
               OnClick='() => SelectCategory("ALL")'>
        Tất cả (@_items.Count)
    </MudButton>
    <MudButton Variant="@(_categoryFilter == "WORK" ? Variant.Filled : Variant.Outlined)"
               Color="@(_categoryFilter == "WORK" ? Color.Primary : Color.Default)"
               Size="Size.Small"
               StartIcon="@Icons.Material.Outlined.Engineering"
               OnClick='() => SelectCategory("WORK")'>
        Nhân viên lao động (@_items.Count(x => x.HasWorkProfile))
    </MudButton>
    <MudButton Variant="@(_categoryFilter == "STUDY" ? Variant.Filled : Variant.Outlined)"
               Color="@(_categoryFilter == "STUDY" ? Color.Primary : Color.Default)"
               Size="Size.Small"
               StartIcon="@Icons.Material.Outlined.School"
               OnClick='() => SelectCategory("STUDY")'>
        Du học sinh (@_items.Count(x => x.HasStudyProfile))
    </MudButton>
    <MudButton Variant="@(_categoryFilter == "FAMILY_VISIT" ? Variant.Filled : Variant.Outlined)"
               Color="@(_categoryFilter == "FAMILY_VISIT" ? Color.Primary : Color.Default)"
               Size="Size.Small"
               StartIcon="@Icons.Material.Outlined.FamilyRestroom"
               OnClick='() => SelectCategory("FAMILY_VISIT")'>
        Người thăm thân (@_items.Count(x => x.HasFamilyVisitProfile))
    </MudButton>
    <MudButton Variant="@(_categoryFilter == "EXPIRING" ? Variant.Filled : Variant.Outlined)"
               Color="@(_categoryFilter == "EXPIRING" ? Color.Primary : Color.Default)"
               Size="Size.Small"
               StartIcon="@Icons.Material.Outlined.Warning"
               OnClick='() => SelectCategory("EXPIRING")'>
        Sắp hết hạn ≤30 ngày (@_items.Count(x => x.DaysUntilExpiry.HasValue && x.DaysUntilExpiry.Value >= 0 && x.DaysUntilExpiry.Value <= 30))
    </MudButton>
</MudStack>

<!-- ════════════ FILTER TOOLBAR ════════════ -->
<MudPaper Class="pa-3 mb-3 page-filter-card" Elevation="0">
    <MudGrid Spacing="2">
        <MudItem xs="12" sm="4">
            <MudTextField @bind-Value="_search"
                          Placeholder="Tìm theo họ tên, hộ chiếu, công ty, trường, thân nhân..."
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Outlined.Search"
                          Immediate="true"
                          Clearable="true"
                          OnKeyUp="HandleSearchKeyUp" />
        </MudItem>
        <MudItem xs="12" sm="3">
            <MudAutocomplete T="CompanyDto"
                             Value="_selectedCompany"
                             ValueChanged="OnCompanyFilterChanged"
                             Label="Công ty / Đơn vị"
                             Placeholder="Tất cả công ty"
                             SearchFunc="SearchCompanyAsync"
                             ToStringFunc="@(c => c?.CompanyName ?? "")"
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense"
                             Clearable="true"
                             ResetValueOnEmptyText="true" />
        </MudItem>
        <MudItem xs="6" sm="2">
            <MudSelect T="string"
                       @bind-Value="_selectedNationality"
                       Label="Quốc tịch"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Clearable="true">
                @foreach (var n in _nationalities)
                {
                    <MudSelectItem T="string" Value="@n.NationalityCode">@n.NationalityName (@n.NationalityCode)</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="6" sm="3" Class="d-flex align-center gap-2">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Outlined.FilterAlt"
                       OnClick="Load"
                       Class="flex-grow-1">
                Lọc
            </MudButton>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Default"
                       OnClick="ResetFilters">
                Đặt lại
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

<!-- ════════════ DATA GRID ════════════ -->
@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-3" />
}
else
{
    <MudDataGrid T="UnifiedForeignPersonDto"
                 Items="FilteredItems"
                 Breakpoint="Breakpoint.None"
                 Hover="true"
                 Striped="true"
                 Class="irm-data-table"
                 RowClassFunc="@((item, _) => item.DaysUntilExpiry is int d ? (d <= 7 ? "row-accent-danger" : d <= 30 ? "row-accent-warning" : "") : "")"
                 RowsPerPage="15"
                 Elevation="0">
        <Columns>
            <TemplateColumn Title="Người nước ngoài" SortBy="x => x.FullName">
                <CellTemplate>
                    @{ var displayName = IRM.Core.Rules.PersonDisplayHelper.FormatName(context.Item.FullName, context.Item.PassportNumber); }
                    <div class="cell-inline" title="@displayName">
                        <span class="cell-primary">@displayName</span>
                        <span class="cell-secondary tabular-nums">
                            · @context.Item.GenderString@(context.Item.Birthday.HasValue ? $", {context.Item.Birthday.Value:yyyy}" : "")
                        </span>
                    </div>
                </CellTemplate>
            </TemplateColumn>

            <TemplateColumn Title="Hộ chiếu" SortBy="x => x.PassportNumber">
                <CellTemplate>
                    <span class="code-pill">@(string.IsNullOrEmpty(context.Item.PassportNumber) ? "—" : context.Item.PassportNumber)</span>
                </CellTemplate>
            </TemplateColumn>

            <TemplateColumn Title="Quốc tịch" SortBy="x => x.NationalityName">
                <CellTemplate>
                    <span class="cell-secondary" style="white-space: nowrap;">@(context.Item.NationalityName ?? context.Item.NationalityCode ?? "—")</span>
                </CellTemplate>
            </TemplateColumn>

            <TemplateColumn Title="Đơn vị / Bảo lãnh">
                <CellTemplate>
                    <div class="cell-truncate">
                        @if (context.Item.HasWorkProfile)
                        {
                            <span class="cell-primary" title="@context.Item.CompanyName">@(context.Item.CompanyName ?? "Chưa gắn công ty")</span>
                            <span class="cell-secondary"> · @(context.Item.CareerName ?? context.Item.WorkPermitString)</span>
                        }
                        else if (context.Item.HasStudyProfile)
                        {
                            <span class="cell-primary" title="@context.Item.SchoolName">@(context.Item.SchoolName ?? "Du học sinh")</span>
                            <span class="cell-secondary"> · @(context.Item.Major ?? context.Item.EducationLevelString)</span>
                        }
                        else if (context.Item.HasFamilyVisitProfile)
                        {
                            <span class="cell-primary">@(context.Item.RelativeName ?? "—")</span>
                            <span class="cell-secondary"> · @(context.Item.Relationship ?? "Thân nhân")</span>
                        }
                        else if (!string.IsNullOrEmpty(context.Item.ResidenceAddress))
                        {
                            <span class="cell-secondary" title="@context.Item.ResidenceAddress">@context.Item.ResidenceAddress</span>
                        }
                        else
                        {
                            <span class="cell-secondary">—</span>
                        }
                    </div>
                </CellTemplate>
            </TemplateColumn>

            <TemplateColumn Title="Diện">
                <CellTemplate>
                    @{
                        var purposes = new List<string>();
                        if (context.Item.HasWorkProfile) purposes.Add("Lao động");
                        if (context.Item.HasStudyProfile) purposes.Add("Du học");
                        if (context.Item.HasFamilyVisitProfile) purposes.Add("Thăm thân");
                        if (purposes.Count == 0)
                        {
                            foreach (var code in context.Item.PurposeCodes)
                            {
                                purposes.Add(GetPurposeMeta(code).Label);
                            }
                        }
                        var purposeText = purposes.Count > 0 ? string.Join(", ", purposes) : "Chưa phân diện";
                    }
                    <div class="cell-truncate" style="max-width: 110px;" title="@purposeText">
                        <span class="cell-secondary">@purposeText</span>
                    </div>
                </CellTemplate>
            </TemplateColumn>

            <TemplateColumn Title="Hạn tạm trú" SortBy="x => x.EffectiveExpiryDate" HeaderStyle="text-align: right;" CellStyle="text-align: right;">
                <CellTemplate>
                    @if (context.Item.EffectiveExpiryDate.HasValue)
                    {
                        var days = context.Item.DaysUntilExpiry ?? (int)(context.Item.EffectiveExpiryDate.Value.Date - DateTime.Today).TotalDays;
                        var statusClass = days <= 7 ? "status-urgent" : days <= 30 ? "status-warning" : "status-safe";
                        <span class="status-pill @statusClass tabular-nums">
                            <span class="status-dot"></span>
                            <span class="code-pill">@context.Item.EffectiveExpiryDate.Value.ToString("dd/MM/yyyy")</span>
                            <span>(@(days >= 0 ? $"{days} ngày" : $"Quá {-days} ngày"))</span>
                        </span>
                    }
                    else
                    {
                        <span class="status-pill status-neutral">Chưa có hạn</span>
                    }
                </CellTemplate>
            </TemplateColumn>

            <TemplateColumn Title="Thao tác" HeaderClass="col-actions" CellClass="col-actions" HeaderStyle="text-align: right;" CellStyle="text-align: right;">
                <CellTemplate>
                    <div class="d-flex align-center justify-end gap-1">
                        <MudTooltip Text="Xem / Sửa hồ sơ đầy đủ (5 Tab)">
                            <MudIconButton Icon="@Icons.Material.Outlined.Edit"
                                           Size="Size.Small"
                                           Color="Color.Warning"
                                           OnClick="@(() => OpenEditPerson(context.Item))" />
                        </MudTooltip>
                        <AuthorizeView Roles="ADMIN,DATA_EDITOR" Context="permissionContext">
                            @if (context.Item.ForeignPersonId.HasValue)
                            {
                                <MudTooltip Text="Thêm nhanh giấy tờ XNC">
                                    <MudIconButton Icon="@Icons.Material.Outlined.NoteAdd"
                                                   Size="Size.Small"
                                                   Color="Color.Primary"
                                                   OnClick="@(() => OpenDocument(context.Item))" />
                                </MudTooltip>
                            }
                            <MudTooltip Text="Xóa hồ sơ">
                                <MudIconButton Icon="@Icons.Material.Outlined.Delete"
                                               Size="Size.Small"
                                               Color="Color.Error"
                                               OnClick="@(() => DeletePersonAsync(context.Item))" />
                            </MudTooltip>
                        </AuthorizeView>
                    </div>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <PagerContent>
            <MudDataGridPager T="UnifiedForeignPersonDto" PageSizeOptions="@(new[] { 10, 15, 25, 50, 100 })" />
        </PagerContent>
    </MudDataGrid>
}

<!-- ════════════ DIALOG: HỒ SƠ NNN ĐA NĂNG (5 TAB) ════════════ -->
<MudDialog @bind-Visible="_profileDialogVisible" Options="@(new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true })">
    <TitleContent>
        <div class="d-flex align-center">
            <MudIcon Icon="@(_isEditingProfile ? Icons.Material.Outlined.EditNote : Icons.Material.Outlined.PersonAdd)" Color="Color.Primary" Class="mr-2" />
            <span>@(_isEditingProfile ? $"Cập nhật hồ sơ NNN: {IRM.Core.Rules.PersonDisplayHelper.FormatName(_form.FullName, _form.PassportNumber)}" : "Thêm mới hồ sơ Người nước ngoài hợp nhất")</span>
        </div>
    </TitleContent>
    <DialogContent>
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mb-3" data-passport-required-notice="true">
            <strong>Yêu cầu bắt buộc:</strong> Hồ sơ Người nước ngoài <strong>PHẢI có Số hộ chiếu</strong> (trường định danh bắt buộc duy nhất; các thông tin khác có thể bổ sung sau).
        </MudAlert>
        <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" Class="irm-tabs">
            <!-- TAB 1: THÔNG TIN CHUNG & CƯ TRÚ -->
            <MudTabPanel Text="1. Thông tin chung & Cư trú" Icon="@Icons.Material.Outlined.Person">
                <MudGrid Spacing="2" Class="pt-4">
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_form.FullName" Label="Họ và tên đầy đủ" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="6" sm="3">
                        <MudSelect T="int" @bind-Value="_form.Gender" Label="Giới tính" Variant="Variant.Outlined" Margin="Margin.Dense">
                            <MudSelectItem Value="1">Nam</MudSelectItem>
                            <MudSelectItem Value="0">Nữ</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="6" sm="3">
                        <MudDatePicker @bind-Date="_form.Birthday" Label="Ngày sinh" Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd/MM/yyyy" />
                    </MudItem>

                    <MudItem xs="12" sm="4">
                        <MudSelect T="string" @bind-Value="_form.NationalityCode" Label="Quốc tịch" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                            @if (!string.IsNullOrWhiteSpace(_form.NationalityCode) && !_nationalities.Any(n => string.Equals(n.NationalityCode, _form.NationalityCode, StringComparison.OrdinalIgnoreCase)))
                            {
                                <MudSelectItem T="string" Value="@_form.NationalityCode">@_form.NationalityCode (Dữ liệu cũ)</MudSelectItem>
                            }
                            @foreach (var n in _nationalities)
                            {
                                <MudSelectItem T="string" Value="@n.NationalityCode">@n.NationalityName (@n.NationalityCode)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudTextField @bind-Value="_form.PassportNumber" Label="Số hộ chiếu *" Required="true" RequiredError="Bắt buộc nhập số hộ chiếu"
                                      Error="@(_profileSubmitted && string.IsNullOrWhiteSpace(_form.PassportNumber))" ErrorText="Bắt buộc nhập số hộ chiếu"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudSelect T="int?" @bind-Value="_form.AdministrativeUnitId" Label="Địa bàn xã/phường tạm trú" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                            @foreach (var u in _units)
                            {
                                <MudSelectItem T="int?" Value="u.Id">@u.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" sm="8">
                        <MudTextField @bind-Value="_form.ResidenceAddress" Label="Địa chỉ tạm trú tại Việt Nam" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudTextField @bind-Value="_form.Note" Label="Ghi chú hồ sơ" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>

                    <MudItem xs="12">
                        <MudDivider Class="my-2" />
                        <MudText Typo="Typo.subtitle2" Class="font-weight-bold mb-2">
                            Chọn các diện thông tin áp dụng cho người này (có thể chọn nhiều diện cùng lúc):
                        </MudText>
                        <MudStack Row="true" Spacing="4" Style="flex-wrap:wrap;">
                            <MudCheckBox T="bool" @bind-Value="_form.HasWorkProfile" Color="Color.Primary" Label="Có thông tin Lao động / Làm việc tại Doanh nghiệp" />
                            <MudCheckBox T="bool" @bind-Value="_form.HasStudyProfile" Color="Color.Secondary" Label="Có thông tin Du học sinh" />
                            <MudCheckBox T="bool" @bind-Value="_form.HasFamilyVisitProfile" Color="Color.Tertiary" Label="Có thông tin Thăm thân tại Việt Nam" />
                        </MudStack>
                    </MudItem>
                </MudGrid>
            </MudTabPanel>

            <!-- TAB 2: LAO ĐỘNG & VIỆC LÀM -->
            <MudTabPanel Text="2. Lao động & Việc làm" Icon="@Icons.Material.Outlined.Engineering">
                <MudGrid Spacing="2">
                    <MudItem xs="12">
                        <MudCheckBox T="bool" @bind-Value="_form.HasWorkProfile" Color="Color.Primary" Label="Kích hoạt thông tin Lao động cho hồ sơ này" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudAutocomplete T="CompanyDto"
                                         Label="Công ty làm việc"
                                         Value="_dialogCompany"
                                         ValueChanged="OnDialogCompanyChanged"
                                         SearchFunc="SearchCompanyAsync"
                                         ToStringFunc="@(c => c?.CompanyName ?? "")"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         ResetValueOnEmptyText="true" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudSelect T="int?" @bind-Value="_form.CareerId" Label="Nghề nghiệp / Vị trí" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                            @foreach (var c in _careers)
                            {
                                <MudSelectItem T="int?" Value="@((int?)c.IDCareer)">@c.CareerName</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudSelect T="WorkPermitType" @bind-Value="_form.WorkPermit" Label="Trạng thái Giấy phép lao động" Variant="Variant.Outlined" Margin="Margin.Dense">
                            <MudSelectItem Value="WorkPermitType.WorkerHasPermit">Đã có GPLĐ</MudSelectItem>
                            <MudSelectItem Value="WorkPermitType.WorkerExempt">Miễn GPLĐ</MudSelectItem>
                            <MudSelectItem Value="WorkPermitType.WorkerNoPermit">Chưa có GPLĐ</MudSelectItem>
                            <MudSelectItem Value="WorkPermitType.InvestorHasPermit">Nhà đầu tư - Có GPLĐ</MudSelectItem>
                            <MudSelectItem Value="WorkPermitType.InvestorExempt">Nhà đầu tư - Miễn GPLĐ</MudSelectItem>
                            <MudSelectItem Value="WorkPermitType.InvestorNoPermit">Nhà đầu tư - Chưa có</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudTextField @bind-Value="_form.WorkPermitNumber" Label="Số Giấy phép lao động" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudDatePicker @bind-Date="_form.TemporaryStay" Label="Hạn tạm trú lao động" Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd/MM/yyyy" Clearable="true" />
                    </MudItem>
                </MudGrid>
            </MudTabPanel>

            <!-- TAB 3: DU HỌC SINH -->
            <MudTabPanel Text="3. Du học sinh" Icon="@Icons.Material.Outlined.School">
                <MudGrid Spacing="2">
                    <MudItem xs="12">
                        <MudCheckBox T="bool" @bind-Value="_form.HasStudyProfile" Color="Color.Secondary" Label="Kích hoạt thông tin Du học sinh cho hồ sơ này" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_form.SchoolName" Label="Trường đào tạo" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_form.Major" Label="Ngành học / Chuyên ngành" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="6" sm="4">
                        <MudSelect T="EducationLevel" @bind-Value="_form.EducationLevel" Label="Trình độ đào tạo" Variant="Variant.Outlined" Margin="Margin.Dense">
