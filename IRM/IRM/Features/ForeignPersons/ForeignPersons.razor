                            <MudSelectItem Value="EducationLevel.Master">Thạc sĩ</MudSelectItem>
                            <MudSelectItem Value="EducationLevel.Doctorate">Tiến sĩ</MudSelectItem>
                            <MudSelectItem Value="EducationLevel.ShortTerm">Ngắn hạn</MudSelectItem>
                            <MudSelectItem Value="EducationLevel.Other">Khác</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="6" sm="4">
                        <MudSelect T="ScholarshipType" @bind-Value="_form.ScholarshipType" Label="Loại học bổng" Variant="Variant.Outlined" Margin="Margin.Dense">
                            <MudSelectItem Value="ScholarshipType.SelfFunded">Tự túc</MudSelectItem>
                            <MudSelectItem Value="ScholarshipType.VietnamGovernment">HB Chính phủ VN</MudSelectItem>
                            <MudSelectItem Value="ScholarshipType.ForeignScholarship">HB nước ngoài</MudSelectItem>
                            <MudSelectItem Value="ScholarshipType.Other">Khác</MudSelectItem>
