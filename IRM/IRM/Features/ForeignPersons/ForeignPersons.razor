                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudSelect T="StudentStatus" @bind-Value="_form.StudentStatus" Label="Trạng thái học tập" Variant="Variant.Outlined" Margin="Margin.Dense">
                            <MudSelectItem Value="StudentStatus.Studying">Đang học</MudSelectItem>
                            <MudSelectItem Value="StudentStatus.Graduated">Đã tốt nghiệp</MudSelectItem>
                            <MudSelectItem Value="StudentStatus.OnLeave">Tạm nghỉ</MudSelectItem>
                            <MudSelectItem Value="StudentStatus.Returned">Đã về nước</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="6" sm="4">
                        <MudDatePicker @bind-Date="_form.EnrollmentDate" Label="Ngày nhập học" Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd/MM/yyyy" Clearable="true" />
                    </MudItem>
                    <MudItem xs="6" sm="4">
                        <MudDatePicker @bind-Date="_form.GraduationDate" Label="Dự kiến tốt nghiệp" Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd/MM/yyyy" Clearable="true" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudTextField @bind-Value="_form.PhoneNumber" Label="Mã sinh viên / Liên hệ" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                </MudGrid>
            </MudTabPanel>

            <!-- TAB 4: THĂM THÂN -->
            <MudTabPanel Text="4. Thăm thân" Icon="@Icons.Material.Outlined.FamilyRestroom">
                <MudGrid Spacing="2">
                    <MudItem xs="12">
                        <MudCheckBox T="bool" @bind-Value="_form.HasFamilyVisitProfile" Color="Color.Tertiary" Label="Kích hoạt thông tin Thăm thân tại Việt Nam cho hồ sơ này" />
                    </MudItem>
                    <MudItem xs="12" sm="5">
                        <MudTextField @bind-Value="_form.RelativeName" Label="Họ và tên thân nhân bảo lãnh" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="6" sm="3">
                        <MudTextField @bind-Value="_form.Relationship" Label="Mối quan hệ (Vợ/chồng, con, cha mẹ...)" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="6" sm="4">
                        <MudSelect T="string" @bind-Value="_form.RelativeTypeCode" Label="Phân loại thân nhân" Variant="Variant.Outlined" Margin="Margin.Dense">
                            <MudSelectItem Value="@("VIETNAMESE_CITIZEN")">Công dân Việt Nam</MudSelectItem>
                            <MudSelectItem Value="@("VIETNAMESE_ORIGIN")">Người gốc Việt Nam</MudSelectItem>
                            <MudSelectItem Value="@("OVERSEAS_VIETNAMESE_DUAL")">Người VN định cư ở nước ngoài</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudTextField @bind-Value="_form.RelativeIdNumber" Label="Số CCCD / CMND / Hộ chiếu thân nhân" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudTextField @bind-Value="_form.RelativePhone" Label="Số điện thoại thân nhân" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudTextField @bind-Value="_form.RelativeAddress" Label="Địa chỉ thường trú thân nhân" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="6" sm="4">
                        <MudDatePicker @bind-Date="_form.VisitStartDate" Label="Thăm thân từ ngày" Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd/MM/yyyy" />
                    </MudItem>
                    <MudItem xs="6" sm="4">
                        <MudDatePicker @bind-Date="_form.VisitEndDate" Label="Thăm thân đến ngày" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd/MM/yyyy" />
                    </MudItem>
                </MudGrid>
            </MudTabPanel>

            <!-- TAB 5: GIẤY TỜ XNC & ĐỊNH DANH ĐT -->
            <MudTabPanel Text="5. Giấy tờ XNC & Định danh ĐT" Icon="@Icons.Material.Outlined.Fingerprint">
                <MudGrid Spacing="2">
                    <MudItem xs="12">
                        <MudText Typo="Typo.subtitle2" Class="font-weight-bold">Thị thực (Visa) / Thẻ tạm trú</MudText>
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudSelect T="string" @bind-Value="_form.DocumentTypeCode" Label="Loại giấy tờ" Variant="Variant.Outlined" Margin="Margin.Dense">
                            <MudSelectItem Value="@ImmigrationDocumentTypeCodes.Visa">Thị thực (Visa)</MudSelectItem>
                            <MudSelectItem Value="@ImmigrationDocumentTypeCodes.VisaExtension">Gia hạn tạm trú</MudSelectItem>
                            <MudSelectItem Value="@ImmigrationDocumentTypeCodes.TemporaryResidenceCard">Thẻ tạm trú (TRC)</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudTextField @bind-Value="_form.DocumentNumber" Label="Số Visa / Số thẻ tạm trú" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudTextField @bind-Value="_form.VisaSymbol" Label="Ký hiệu Visa (VD: LĐ1, LĐ2, ĐT, TT, DH...)" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="6" sm="4">
                        <MudDatePicker @bind-Date="_form.DocumentValidFrom" Label="Giấy tờ có hiệu lực từ ngày" Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd/MM/yyyy" Clearable="true" />
                    </MudItem>
                    <MudItem xs="6" sm="4">
                        <MudDatePicker @bind-Date="_form.DocumentValidTo" Label="Hạn giấy tờ đến ngày" Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd/MM/yyyy" Clearable="true" />
                    </MudItem>

                    <MudItem xs="12">
                        <MudDivider Class="my-2" />
                        <MudText Typo="Typo.subtitle2" Class="font-weight-bold">Định danh điện tử đã được cấp</MudText>
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudTextField @bind-Value="_form.ElectronicIdentityNumber" Label="Mã số định danh điện tử" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="Nhập số định danh đã có" />
                    </MudItem>
                    <MudItem xs="6" sm="4">
                        <MudDatePicker @bind-Date="_form.ElectronicIdentityValidFrom" Label="Ngày kích hoạt định danh" Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd/MM/yyyy" Clearable="true" />
                    </MudItem>
                    <MudItem xs="6" sm="4">
                        <MudDatePicker @bind-Date="_form.ElectronicIdentityValidTo" Label="Hạn định danh đến ngày" Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd/MM/yyyy" Clearable="true" />
                    </MudItem>
                </MudGrid>
            </MudTabPanel>
        </MudTabs>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _profileDialogVisible = false)">Hủy</MudButton>
        <AuthorizeView Roles="ADMIN,DATA_EDITOR">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Save" OnClick="SaveUnifiedProfileAsync">
                Lưu hồ sơ hợp nhất
            </MudButton>
        </AuthorizeView>
    </DialogActions>
</MudDialog>

<!-- ════════════ DIALOG: THÊM NHANH GIẤY TỜ XNK ════════════ -->
<MudDialog @bind-Visible="_documentDialog" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true })">
    <TitleContent>
        <div class="d-flex align-center">
            <MudIcon Icon="@Icons.Material.Outlined.Article" Color="Color.Primary" Class="mr-2" />
            <span>Thêm giấy tờ xuất nhập cảnh</span>
        </div>
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12">
                <MudSelect T="string" @bind-Value="_document.TypeCode" Label="Loại giấy tờ *" Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem Value="@ImmigrationDocumentTypeCodes.Visa">Thị thực (Visa)</MudSelectItem>
                    <MudSelectItem Value="@ImmigrationDocumentTypeCodes.VisaExtension">Gia hạn tạm trú</MudSelectItem>
                    <MudSelectItem Value="@ImmigrationDocumentTypeCodes.TemporaryResidenceCard">Thẻ tạm trú (TRC)</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_document.Number" Label="Số văn bản / Số thẻ *" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="6">
                <MudDatePicker @bind-Date="_documentFrom" Label="Từ ngày *" Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd/MM/yyyy" />
            </MudItem>
            <MudItem xs="6">
                <MudDatePicker @bind-Date="_documentTo" Label="Hạn đến ngày" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd/MM/yyyy" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _documentDialog = false)">Hủy</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveDocument">Lưu giấy tờ</MudButton>
    </DialogActions>
</MudDialog>

<!-- ════════════ DIALOG: XÁC NHẬN XÓA LƯU TRỮ HẾT HẠN ════════════ -->
<MudDialog @bind-Visible="_archiveDialogVisible" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true })">
    <TitleContent>
        <MudText Typo="Typo.h6" Style="font-weight: 700; color: var(--red);">
            Xác nhận xóa @_archiveDialogTitle
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
            <strong>@_archiveCount</strong> hồ sơ @_archiveDialogTitle sẽ được di chuyển sang bảng lưu trữ.
        </MudAlert>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Dữ liệu sẽ được lưu vào bảng <strong>Lưu trữ</strong> và ẩn khỏi danh sách chính.
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="@(() => _archiveDialogVisible = false)">Hủy</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error"
                   StartIcon="@Icons.Material.Outlined.DeleteForever"
                   OnClick="ExecuteArchiveAsync"
                   Disabled="@(_archiveProcessing || _archiveCount == 0)">
            Xóa @_archiveCount hồ sơ
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<UnifiedForeignPersonDto> _items = new();
    private List<NationalityEntityDto> _nationalities = new();
    private List<CareerDto> _careers = new();
    private List<AdministrativeUnitDto> _units = new();
    private List<CompanyDto> _companies = new();

    private string? _search;
    private string _categoryFilter = "ALL";
    private CompanyDto? _selectedCompany;
    private string? _selectedNationality;
    private DateTime? _asOf = DateTime.Today;
    private DateTime At = DateTime.Today;
    private bool _loading;

    // 5-Tab Unified Dialog
    private bool _profileDialogVisible;
    private bool _isEditingProfile;
    private UnifiedForeignPersonInput _form = new();
    private CompanyDto? _dialogCompany;

    // Quick Document dialog
    private bool _documentDialog;
    private ImmigrationDocumentDto _document = new();
    private DateTime? _documentFrom = DateTime.Today;
    private DateTime? _documentTo;

    // Archive dialog
    private bool _archiveDialogVisible;
    private string _archiveDialogTitle = "";
    private string _archiveType = "";
    private int _archiveCount;
    private bool _archiveProcessing;

    private IEnumerable<UnifiedForeignPersonDto> FilteredItems
    {
        get
        {
            IEnumerable<UnifiedForeignPersonDto> query = _items;

            query = _categoryFilter switch
            {
                "WORK" => query.Where(x => x.HasWorkProfile),
                "STUDY" => query.Where(x => x.HasStudyProfile),
                "FAMILY_VISIT" => query.Where(x => x.HasFamilyVisitProfile),
                "STUDY_FAMILY" => query.Where(x => x.HasStudyProfile || x.HasFamilyVisitProfile),
                "EXPIRING" => query.Where(x => x.DaysUntilExpiry.HasValue && x.DaysUntilExpiry.Value >= 0 && x.DaysUntilExpiry.Value <= 30),
                _ => query
            };

            if (_selectedCompany is not null)
                query = query.Where(x => x.CompanyId == _selectedCompany.IDCompany);

            if (!string.IsNullOrWhiteSpace(_selectedNationality))
                query = query.Where(x => string.Equals(x.NationalityCode, _selectedNationality, StringComparison.OrdinalIgnoreCase));

            return query;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        ApplyRouteCategoryDefault();
        _nationalities = await Catalog.GetNationalitiesAsync();
        _careers = await Catalog.GetCareersAsync();
        _units = (await Catalog.GetAdministrativeUnitsAsync()).ToList();
        _companies = await CompanySvc.GetAllAsync();
        await Load();
    }

    protected override void OnParametersSet()
    {
        ApplyRouteCategoryDefault();
    }

    private void ApplyRouteCategoryDefault()
    {
        var path = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/').ToLowerInvariant();
        if (path.EndsWith("/employees"))
            _categoryFilter = "WORK";
        else if (path.EndsWith("/students"))
            _categoryFilter = "STUDY";
        else if (path.EndsWith("/family-visitors"))
            _categoryFilter = "FAMILY_VISIT";
    }

    private void SelectCategory(string category)
    {
        _categoryFilter = category;
    }

    private async Task Load()
    {
        _loading = true;
        try
        {
            At = (_asOf ?? DateTime.Today).Date;
            _items = (await Registry.GetUnifiedProfilesAsync(_search, At)).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Lỗi tải dữ liệu: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private Task<IEnumerable<CompanyDto>> SearchCompanyAsync(string? value, CancellationToken cancel)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Task.FromResult<IEnumerable<CompanyDto>>(_companies);
        return Task.FromResult(_companies.Where(c => c.CompanyName.Contains(value, StringComparison.OrdinalIgnoreCase)));
    }

    private void OnCompanyFilterChanged(CompanyDto? company)
    {
        _selectedCompany = company;
    }

    private void OnDialogCompanyChanged(CompanyDto? company)
    {
        _dialogCompany = company;
        _form.CompanyId = company?.IDCompany;
        if (company is not null)
            _form.HasWorkProfile = true;
    }

    private async Task HandleSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await Load();
    }

    private async Task ResetFilters()
    {
        _search = null;
        _selectedCompany = null;
        _selectedNationality = null;
        _categoryFilter = "ALL";
        _asOf = DateTime.Today;
        await Load();
    }

    private (string Label, string ColorClass) GetPurposeMeta(string code) => code switch
    {
        StayPurposeCodes.Work => ("Lao động", "purpose-blue"),
        StayPurposeCodes.FamilyVisit => ("Thăm thân", "purpose-purple"),
        StayPurposeCodes.Study => ("Du học", "purpose-cyan"),
        StayPurposeCodes.Tourism => ("Du lịch", "purpose-amber"),
        _ => ("Khác", "purpose-gray")
    };

    private void OpenAddPerson()
    {
        _isEditingProfile = false;
        _form = new UnifiedForeignPersonInput
        {
            Gender = 1,
            HasWorkProfile = _categoryFilter is "ALL" or "WORK",
            HasStudyProfile = _categoryFilter == "STUDY",
            HasFamilyVisitProfile = _categoryFilter == "FAMILY_VISIT",
            CareerId = _careers.FirstOrDefault()?.IDCareer,
            VisitStartDate = DateTime.Today,
            DocumentValidFrom = DateTime.Today,
            ElectronicIdentityValidFrom = DateTime.Today
        };
        _dialogCompany = _selectedCompany;
        if (_dialogCompany is not null)
            _form.CompanyId = _dialogCompany.IDCompany;
        _profileDialogVisible = true;
    }

    private void OpenEditPerson(UnifiedForeignPersonDto item)
    {
        _isEditingProfile = true;
        _form = new UnifiedForeignPersonInput
        {
            ForeignPersonId = item.ForeignPersonId,
            EmployeeId = item.EmployeeId,
            StudentId = item.StudentId,
            FamilyVisitStayCaseId = item.FamilyVisitStayCaseId,
            FullName = item.FullName,
            Gender = item.Gender,
            Birthday = item.Birthday,
            NationalityCode = item.NationalityCode,
            PassportNumber = item.PassportNumber,
            AdministrativeUnitId = item.AdministrativeUnitId,
            ResidenceAddress = item.ResidenceAddress,
            Note = item.Note,

            HasWorkProfile = item.HasWorkProfile,
            HasStudyProfile = item.HasStudyProfile,
            HasFamilyVisitProfile = item.HasFamilyVisitProfile,

            CompanyId = item.CompanyId,
            CareerId = item.CareerId ?? _careers.FirstOrDefault()?.IDCareer,
            WorkPermit = item.WorkPermit,
            WorkPermitNumber = item.WorkPermitNumber,
            TemporaryStay = item.TemporaryStay,

            SchoolName = item.SchoolName,
            Major = item.Major,
            EducationLevel = item.EducationLevel,
            ScholarshipType = item.ScholarshipType,
            EnrollmentDate = item.EnrollmentDate,
            GraduationDate = item.GraduationDate,
            StudentStatus = item.StudentStatus,
            VisaExpiry = item.VisaExpiry,
            PhoneNumber = item.PhoneNumber,

            RelativeName = item.RelativeName,
            Relationship = item.Relationship,
            RelativeTypeCode = item.RelativeTypeCode,
            RelativeNationalityCode = item.RelativeNationalityCode,
            RelativeIdNumber = item.RelativeIdNumber,
            RelativePhone = item.RelativePhone,
            RelativeAddress = item.RelativeAddress,
            VisitStartDate = item.VisitStartDate ?? DateTime.Today,
            VisitEndDate = item.VisitEndDate,

            DocumentTypeCode = item.PrimaryDocumentType ?? ImmigrationDocumentTypeCodes.Visa,
            DocumentNumber = item.PrimaryDocumentNumber ?? item.VisaNumber,
            VisaSymbol = item.VisaSymbol,
            DocumentValidFrom = item.PrimaryDocumentValidFrom ?? DateTime.Today,
            DocumentValidTo = item.PrimaryDocumentValidTo ?? item.TemporaryStay ?? item.VisaExpiry,
            ElectronicIdentityNumber = item.ElectronicIdNumber,
            ElectronicIdentityValidFrom = item.ElectronicIdValidFrom ?? DateTime.Today,
            ElectronicIdentityValidTo = item.ElectronicIdValidTo
        };
        _dialogCompany = _companies.FirstOrDefault(c => c.IDCompany == item.CompanyId);
        _profileDialogVisible = true;
    }

    private bool _profileSubmitted;

    private async Task SaveUnifiedProfileAsync()
    {
        _profileSubmitted = true;
        if (string.IsNullOrWhiteSpace(_form.PassportNumber))
        {
            Snackbar.Add("Vui lòng nhập Số hộ chiếu (trường bắt buộc duy nhất).", Severity.Warning);
            return;
        }
        try
        {
            await Registry.SaveUnifiedProfileAsync(_form);
            _profileSubmitted = false;
            _profileDialogVisible = false;
            await Load();
            Snackbar.Add(_isEditingProfile ? "Đã cập nhật hồ sơ người nước ngoài." : "Đã tạo mới hồ sơ người nước ngoài.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task DeletePersonAsync(UnifiedForeignPersonDto item)
    {
        try
        {
            await Registry.DeleteUnifiedProfileAsync(item.ForeignPersonId, item.EmployeeId, item.StudentId);
            await Load();
            Snackbar.Add($"Đã xóa hồ sơ {IRM.Core.Rules.PersonDisplayHelper.FormatName(item.FullName, item.PassportNumber)}.", Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task SyncLegacyRecordsAsync()
    {
        try
        {
            var res = await Registry.BackfillLegacyAsync();
            await Load();
            Snackbar.Add($"Đã đồng bộ {res.Linked} hồ sơ (tạo mới {res.Created}, cần rà soát hộ chiếu {res.Issues}).", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task ExportExcelAsync()
    {
        try
        {
            if (_categoryFilter == "STUDY")
            {
                var bytes = await ExportSvc.ExportStudentsAsync(_selectedNationality, null, null, null, null, _categoryFilter == "EXPIRING");
                await JS.InvokeVoidAsync("irmInterop.downloadFile",
                    $"DuHocSinh_{DateTime.Now:yyyyMMdd}.xlsx",
                    "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                    Convert.ToBase64String(bytes));
            }
            else
            {
                var bytes = await ExportSvc.ExportEmployeesAsync(_selectedCompany?.IDCompany, _selectedNationality, null, _categoryFilter == "EXPIRING");
                await JS.InvokeVoidAsync("irmInterop.downloadFile",
                    $"HoSoNNN_{DateTime.Now:yyyyMMdd}.xlsx",
                    "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                    Convert.ToBase64String(bytes));
            }
            Snackbar.Add("Đã xuất file Excel thành công.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Lỗi xuất Excel: {ex.Message}", Severity.Error);
        }
    }

    private async Task OpenArchiveTemporaryStayDialog()
    {
        _archiveType = "TAM_TRU";
        _archiveDialogTitle = "hết hạn tạm trú";
        _archiveCount = await EmployeeSvc.CountExpiredTemporaryStayAsync();
        _archiveDialogVisible = true;
    }

    private async Task OpenArchiveFamilyVisitDialog()
    {
        _archiveType = "THAM_THAN";
        _archiveDialogTitle = "hết hạn thăm thân";
        _archiveCount = await EmployeeSvc.CountExpiredFamilyVisitAsync();
        _archiveDialogVisible = true;
    }

    private async Task ExecuteArchiveAsync()
    {
        _archiveProcessing = true;
        try
        {
            var count = _archiveType == "TAM_TRU"
                ? await EmployeeSvc.ArchiveExpiredTemporaryStayAsync()
                : await EmployeeSvc.ArchiveExpiredFamilyVisitAsync();
            _archiveDialogVisible = false;
            await Load();
            Snackbar.Add($"Đã chuyển {count} hồ sơ sang lưu trữ.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _archiveProcessing = false;
        }
    }

    private void OpenDocument(UnifiedForeignPersonDto person)
    {
        if (!person.ForeignPersonId.HasValue) return;
        _document = new ImmigrationDocumentDto
        {
            ForeignPersonId = person.ForeignPersonId.Value,
            TypeCode = ImmigrationDocumentTypeCodes.Visa
        };
        _documentFrom = DateTime.Today;
        _documentTo = DateTime.Today.AddMonths(6);
        _documentDialog = true;
    }

    private async Task SaveDocument()
    {
        if (string.IsNullOrWhiteSpace(_document.Number))
        {
            Snackbar.Add("Vui lòng nhập số giấy tờ.", Severity.Warning);
            return;
        }

        try
        {
            _document.ValidFrom = (_documentFrom ?? DateTime.Today).Date;
            _document.ValidTo = _documentTo;
            await Registry.SaveDocumentAsync(_document);
            _documentDialog = false;
            await Load();
            Snackbar.Add("Đã lưu giấy tờ xuất nhập cảnh.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

}
