@namespace IRM.Components.Pages
@page "/admin"
@page "/admin/{SectionKey}"

@using IRM.Services
@using IRM.Data.Models
@using Microsoft.AspNetCore.Components.Web

<PageTitle>Quản trị - IRM v1.0.2</PageTitle>

<div class="section-header">
    <h3>Quản trị hệ thống</h3>
    <span class="section-meta">Quản lý danh mục và cấu hình hệ thống</span>
</div>

<div class="admin-grid">
    @foreach (var card in _adminCards)
    {
        var isActive = string.Equals(card.Key, _activeSection, StringComparison.OrdinalIgnoreCase);
        <div class="admin-card admin-card-action @(isActive ? "active" : "")"
             role="button"
             tabindex="0"
             @onclick="() => GoSection(card.Key)"
             @onkeydown="e => OnCardKeyDown(e, card.Key)">
            <MudIcon Icon="@card.Icon" Class="admin-icon" />
            <MudText Typo="Typo.subtitle1" Style="font-weight:700;">@card.Title</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">@card.Description</MudText>
        </div>
    }
</div>

@if (!string.IsNullOrWhiteSpace(_activeSection))
{
    <div class="section-header mt-6">
        <h3>@_activeSectionTitle</h3>
        <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick='() => Nav.NavigateTo("/admin")'
                   StartIcon="@Icons.Material.Filled.ArrowBack">Về trang quản trị</MudButton>
    </div>
}

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
}
else if (!string.IsNullOrWhiteSpace(_activeSection))
{
    @switch (_activeSection)
    {
        case "accounts":
            <AdminAccountsSection Page="this" />
            break;

        case "fields":
            <AdminFieldsSection Page="this" />
            break;

        case "careers":
            <AdminCareersSection Page="this" />
            break;

        case "nationalities":
            <AdminNationalitiesSection Page="this" />
            break;

        case "districts":
            <AdminDistrictsSection Page="this" />
            break;

        case "wards":
            <AdminWardsSection Page="this" />
            break;

        case "admin-units":
            <AdminAdministrativeUnitsSection Page="this" />
            break;

        case "audit":
            <AdminAuditSection Page="this" />
            break;

        case "import-history":
            <AdminImportHistorySection Page="this" />
            break;

        case "legacy-sync":
            <AdminLegacySyncSection Page="this" />
            break;

        default:
            <MudAlert Severity="Severity.Warning">Không tìm thấy module quản trị: @_activeSection</MudAlert>
            break;
    }
}
