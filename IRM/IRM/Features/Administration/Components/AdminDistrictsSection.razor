@namespace IRM.Components.Pages
@inherits IRM.Components.Shared.FeatureSection<Admin>

<MudPaper Class="pa-4 mb-4">
                <MudGrid>
                    <MudItem xs="12" md="8">
                        <MudTextField T="string" Label="Tên quận/huyện" @bind-Value="Page._districtForm.DisTrictName" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" md="4" Class="d-flex align-center">
                        <MudStack Row="true" Spacing="1">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Page.SaveDistrictAsync">@(Page._editingDistrict ? "Luu" : "Them")</MudButton>
                            <MudButton Variant="Variant.Text" OnClick="Page.ResetDistrictForm">Hủy</MudButton>
                        </MudStack>
                    </MudItem>
                </MudGrid>
            </MudPaper>
            <MudSimpleTable Dense="true" Hover="true" Striped="true" Class="admin-detail-table">
                <thead><tr><th>ID</th><th>Tên quận/huyện</th><th></th></tr></thead>
                <tbody>
                    @foreach (var d in Page._districts)
                    {
                        <tr>
                            <td>@d.IDDistrict</td>
                            <td>@d.DisTrictName</td>
                            <td>
                                <MudStack Row="true" Spacing="1">
                                    <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => Page.EditDistrict(d))">Sửa</MudButton>
                                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Error" OnClick="@(() => Page.DeleteDistrictAsync(d.IDDistrict))">Xóa</MudButton>
                                </MudStack>
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
