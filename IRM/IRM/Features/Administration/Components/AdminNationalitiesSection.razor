@namespace IRM.Components.Pages
@inherits IRM.Components.Shared.FeatureSection<Admin>

<MudPaper Class="pa-4 mb-4">
                <MudGrid>
                    <MudItem xs="12" md="3">
                        <MudTextField T="string" Label="Ma quoc tich" @bind-Value="Page._nationalityForm.NationalityCode" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField T="string" Label="Ten quoc tich" @bind-Value="Page._nationalityForm.NationalityName" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" md="3" Class="d-flex align-center">
                        <MudStack Row="true" Spacing="1">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Page.SaveNationalityAsync">@(Page._editingNationality ? "Luu" : "Them")</MudButton>
                            <MudButton Variant="Variant.Text" OnClick="Page.ResetNationalityForm">Hủy</MudButton>
                        </MudStack>
                    </MudItem>
                </MudGrid>
            </MudPaper>
            <MudSimpleTable Dense="true" Hover="true" Striped="true" Class="admin-detail-table">
                <thead><tr><th>Ma</th><th>Ten quoc tich</th><th></th></tr></thead>
                <tbody>
                    @foreach (var n in Page._nationalities)
                    {
                        <tr>
                            <td>@n.NationalityCode</td>
                            <td>@n.NationalityName</td>
                            <td>
                                <MudStack Row="true" Spacing="1">
                                    <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => Page.EditNationality(n))">Sửa</MudButton>
                                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Error" OnClick="@(() => Page.DeleteNationalityAsync(n.IDNationality))">Xóa</MudButton>
                                </MudStack>
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
